---
import Layout from '../layouts/Layout.astro';
const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
---

<Layout title="Contact — ATLAS CREA" description="Contactez ATLAS CREA pour discuter de votre projet. Réponse sous 24h.">
  <div class="noise-overlay"></div>

  <!-- Hero -->
  <section class="pt-36 pb-20 bg-brand-navy relative overflow-hidden">
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-brand-purple/10 blur-[120px] rounded-full"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="section-label">CONTACT</div>
      <h1 class="text-[clamp(2.5rem,8vw,5rem)] font-kanit font-bold leading-[0.95] text-white mb-6">
        Parlons de votre <span class="gradient-text">projet.</span>
      </h1>
      <p class="text-white/50 text-lg max-w-2xl">Une idée, un projet ? Remplissez le formulaire et nous vous répondons sous 24h.</p>
    </div>
  </section>

  <!-- Contact Grid -->
  <section class="py-20 bg-brand-navy">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-16">
        <!-- Form -->
        <div class="section-fade">
          <form name="contact" method="POST" netlify data-netlify="true" class="space-y-6">
            <input type="hidden" name="form-name" value="contact" />
            <div>
              <label class="block text-white/60 text-xs font-mono uppercase tracking-widest mb-2">Nom complet</label>
              <input type="text" name="name" required placeholder="Votre nom" class="input-field" />
            </div>
            <div>
              <label class="block text-white/60 text-xs font-mono uppercase tracking-widest mb-2">Email</label>
              <input type="email" name="email" required placeholder="votre@email.com" class="input-field" />
            </div>
            <div>
              <label class="block text-white/60 text-xs font-mono uppercase tracking-widest mb-2">Téléphone</label>
              <input type="tel" name="phone" placeholder="+212 6 XX XX XX XX" class="input-field" />
            </div>
            <div>
              <label class="block text-white/60 text-xs font-mono uppercase tracking-widest mb-2">Service souhaité</label>
              <select name="service" class="input-field">
                <option value="">Sélectionnez un service</option>
                <option value="branding">Branding & Identité</option>
                <option value="web">Création de Sites Web</option>
                <option value="social">Social Media & Contenu</option>
                <option value="print">Print & Supports Physiques</option>
                <option value="seo">SEO & Référencement</option>
                <option value="ads">Publicité Digitale</option>
                <option value="other">Autre</option>
              </select>
            </div>
            <div>
              <label class="block text-white/60 text-xs font-mono uppercase tracking-widest mb-2">Message</label>
              <textarea name="message" rows="5" placeholder="Décrivez votre projet..." class="input-field resize-none"></textarea>
            </div>
            <button type="submit" class="btn-primary w-full justify-center">
              Envoyer le message →
            </button>
          </form>
        </div>

        <!-- Contact Info -->
        <div class="section-fade space-y-12">
          <div>
            <h3 class="font-kanit font-bold text-white text-lg mb-6">Coordonnées</h3>
            <ul class="space-y-6">
              <li class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-full bg-gradient-to-br from-brand-purple/20 to-brand-cyan/20 flex items-center justify-center flex-shrink-0">
                  <svg class="w-4 h-4 text-brand-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                </div>
                <div>
                  <p class="text-white/40 text-xs font-mono uppercase tracking-widest">Email</p>
                  <a href="mailto:contact@atlascrea.com" class="text-white hover:text-brand-cyan transition-colors">contact@atlascrea.com</a>
                </div>
              </li>
              <li class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-full bg-gradient-to-br from-brand-purple/20 to-brand-cyan/20 flex items-center justify-center flex-shrink-0">
                  <svg class="w-4 h-4 text-brand-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                </div>
                <div>
                  <p class="text-white/40 text-xs font-mono uppercase tracking-widest">Téléphone</p>
                  <a href="tel:+212605048514" class="text-white hover:text-brand-cyan transition-colors">+212 6 05 04 85 14</a>
                </div>
              </li>
              <li class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-full bg-gradient-to-br from-brand-purple/20 to-brand-cyan/20 flex items-center justify-center flex-shrink-0">
                  <svg class="w-4 h-4 text-brand-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                </div>
                <div>
                  <p class="text-white/40 text-xs font-mono uppercase tracking-widest">Adresse</p>
                  <p class="text-white/70">Marrakech, Maroc</p>
                </div>
              </li>
            </ul>
          </div>

          <div>
            <h3 class="font-kanit font-bold text-white text-lg mb-6">Suivez-nous</h3>
            <div class="flex gap-4">
              <a href="https://instagram.com/atlascrea" target="_blank" class="w-12 h-12 rounded-full border border-white/10 flex items-center justify-center hover:border-brand-cyan hover:bg-brand-cyan/10 transition-all duration-300">
                <svg class="w-5 h-5 text-white/60" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 1.366.062 2.633.336 3.608 1.311.975.975 1.249 2.242 1.311 3.608.058 1.266.07 1.646.07 4.85s-.012 3.584-.07 4.85c-.062 1.366-.336 2.633-1.311 3.608-.975.975-2.242 1.249-3.608 1.311-1.266.058-1.646.07-4.85.07s-3.584-.012-4.85-.07c-1.366-.062-2.633-.336-3.608-1.311-.975-.975-1.249-2.242-1.311-3.608C2.175 15.584 2.163 15.204 2.163 12s.012-3.584.07-4.85c.062-1.366.336-2.633 1.311-3.608.975-.975 2.242-1.249 3.608-1.311C8.416 2.175 8.796 2.163 12 2.163zm0 10.162c-2.209 0-4-1.791-4-4s1.791-4 4-4 4 1.791 4 4-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
              </a>
              <a href="https://facebook.com/atlascrea" target="_blank" class="w-12 h-12 rounded-full border border-white/10 flex items-center justify-center hover:border-brand-cyan hover:bg-brand-cyan/10 transition-all duration-300">
                <svg class="w-5 h-5 text-white/60" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>
              <a href="https://linkedin.com/company/atlascrea" target="_blank" class="w-12 h-12 rounded-full border border-white/10 flex items-center justify-center hover:border-brand-cyan hover:bg-brand-cyan/10 transition-all duration-300">
                <svg class="w-5 h-5 text-white/60" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </a>
            </div>
          </div>

          <!-- WhatsApp -->
          <a href="https://wa.me/212605048514?text=Bonjour%20ATLAS%20CREA%20!%20J%27aimerais%20avoir%20plus%20d%27informations" target="_blank" class="flex items-center gap-4 p-4 rounded-2xl border border-white/10 hover:border-brand-cyan/30 hover:bg-brand-cyan/5 transition-all duration-300 group">
            <div class="w-10 h-10 rounded-full bg-green-500/20 flex items-center justify-center">
              <svg class="w-5 h-5 text-green-400" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/></svg>
            </div>
            <div>
              <p class="text-white font-medium text-sm">WhatsApp Direct</p>
              <p class="text-white/30 text-xs">Réponse sous 24h</p>
            </div>
            <span class="ml-auto text-white/20 group-hover:text-brand-cyan transition-colors">→</span>
          </a>

          <!-- Map -->
          <div class="rounded-2xl overflow-hidden border border-white/10 h-64">
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d67801.89592019959!2d-8.02856454327392!3d31.64139080015985!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xdafee8d96179e51%3A0x4b9c5b3d7b5f7b9f!2sMarrakech!5e0!3m2!1sfr!2sma!4v1" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
