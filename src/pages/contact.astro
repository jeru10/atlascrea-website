---
import Layout from '../layouts/Layout.astro';
const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
---

<Layout title="Contact — ATLAS CREA" description="Contactez ATLAS CREA pour discuter de votre projet. Réponse sous 24h.">

  <!-- ═══════ HERO ═══════ -->
  <section class="relative min-h-[60vh] flex items-center pt-32 pb-20 overflow-hidden bg-bg">
    <div class="absolute inset-0 hero-mesh"></div>
    <div class="hero-grain"></div>
    <div class="hero-scanlines"></div>

    <div class="max-w-7xl mx-auto px-6 lg:px-12 relative z-10">
      <p class="text-[11px] font-mono uppercase tracking-[0.2em] text-muted mb-6">Contact</p>
      <h1 class="font-syne font-extrabold text-[clamp(3rem,8vw,6rem)] leading-[0.9] tracking-[-0.03em] text-white max-w-4xl mb-6">
        <span class="word-reveal" data-delay="1.0"><span>Parlons</span></span>{' '}
        <span class="word-reveal" data-delay="1.06"><span>de</span></span>{' '}
        <span class="word-reveal text-sky italic" data-delay="1.12"><span>votre</span></span>{' '}
        <span class="word-reveal" data-delay="1.18"><span>projet.</span></span>
      </h1>
      <p class="hero-reveal text-muted text-sm sm:text-base font-dm font-light max-w-xl mb-10" data-delay="1.4">
        Une idée, un projet ? Remplissez le formulaire et nous vous répondons sous 24h.
      </p>
    </div>

    <div class="absolute right-8 bottom-8 hidden lg:flex flex-col items-center gap-3 z-10">
      <span class="text-[10px] font-mono tracking-[0.2em] text-muted vertical-rl" style="writing-mode: vertical-rl;">CONTACT</span>
      <div class="w-px h-16 bg-gradient-to-b from-muted to-transparent"></div>
    </div>
  </section>

  <!-- ═══════ MARQUEE ═══════ -->
  <div class="marquee py-3" style="background: #3654E3;">
    <div class="marquee-inner text-[11px] font-syne font-bold uppercase tracking-[0.2em]" style="color: #020E26;">
      <span>Contactez-nous</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>WhatsApp</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>Email</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>Téléphone</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>Instagram</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>LinkedIn</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>Contactez-nous</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>WhatsApp</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>Email</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>Téléphone</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>Instagram</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>LinkedIn</span><span class="marquee-dot" style="background:#020E26;"></span>
    </div>
  </div>

  <!-- ═══════ CONTACT GRID ═══════ -->
  <section class="py-24 lg:py-32 bg-bg section-divider">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="grid md:grid-cols-2 gap-16">
        <!-- Form -->
        <div>
          <p class="text-[11px] font-mono uppercase tracking-[0.2em] text-blue mb-4">Formulaire</p>
          <h2 class="font-syne font-extrabold text-[clamp(1.5rem,4vw,2.5rem)] leading-[0.95] tracking-[-0.03em] text-white mb-10">
            Envoyez-nous un <span class="text-sky">message</span>
          </h2>

          <form name="contact" method="POST" netlify data-netlify="true" class="space-y-6">
            <input type="hidden" name="form-name" value="contact" />
            <div>
              <label class="block text-muted text-[10px] font-mono uppercase tracking-[0.2em] mb-2">Nom complet</label>
              <input type="text" name="name" required placeholder="Votre nom"
                     class="w-full bg-transparent border border-border px-4 py-3.5 text-white text-sm font-dm font-light outline-none transition-colors focus:border-blue placeholder:text-muted/30" />
            </div>
            <div>
              <label class="block text-muted text-[10px] font-mono uppercase tracking-[0.2em] mb-2">Email</label>
              <input type="email" name="email" required placeholder="votre@email.com"
                     class="w-full bg-transparent border border-border px-4 py-3.5 text-white text-sm font-dm font-light outline-none transition-colors focus:border-blue placeholder:text-muted/30" />
            </div>
            <div>
              <label class="block text-muted text-[10px] font-mono uppercase tracking-[0.2em] mb-2">Téléphone</label>
              <input type="tel" name="phone" placeholder="+212 6 XX XX XX XX"
                     class="w-full bg-transparent border border-border px-4 py-3.5 text-white text-sm font-dm font-light outline-none transition-colors focus:border-blue placeholder:text-muted/30" />
            </div>
            <div>
              <label class="block text-muted text-[10px] font-mono uppercase tracking-[0.2em] mb-2">Service souhaité</label>
              <select name="service"
                      class="w-full bg-transparent border border-border px-4 py-3.5 text-white text-sm font-dm font-light outline-none transition-colors focus:border-blue">
                <option value="" class="bg-bg">Sélectionnez un service</option>
                <option value="branding" class="bg-bg">Branding & Identité</option>
                <option value="web" class="bg-bg">Création de Sites Web</option>
                <option value="social" class="bg-bg">Social Media & Contenu</option>
                <option value="print" class="bg-bg">Print & Supports Physiques</option>
                <option value="seo" class="bg-bg">SEO & Référencement</option>
                <option value="ads" class="bg-bg">Publicité Digitale</option>
                <option value="other" class="bg-bg">Autre</option>
              </select>
            </div>
            <div>
              <label class="block text-muted text-[10px] font-mono uppercase tracking-[0.2em] mb-2">Message</label>
              <textarea name="message" rows="5" placeholder="Décrivez votre projet..."
                        class="w-full bg-transparent border border-border px-4 py-3.5 text-white text-sm font-dm font-light outline-none transition-colors focus:border-blue placeholder:text-muted/30 resize-none"></textarea>
            </div>
            <button type="submit" class="btn-primary w-full justify-center">
              Envoyer le message →
            </button>
          </form>
        </div>

        <!-- Contact Info -->
        <div>
          <p class="text-[11px] font-mono uppercase tracking-[0.2em] text-blue mb-4">Coordonnées</p>
          <h2 class="font-syne font-extrabold text-[clamp(1.5rem,4vw,2.5rem)] leading-[0.95] tracking-[-0.03em] text-white mb-10">
            Venez <span class="text-sky">discuter</span>
          </h2>

          <div class="space-y-8 mb-12">
            <!-- Email -->
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-full bg-blue/10 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4 text-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <p class="text-[10px] font-mono uppercase tracking-[0.2em] text-muted">Email</p>
                <a href="mailto:hello@atlascrea.ma" class="text-white hover:text-sky transition-colors font-dm font-light text-sm">hello@atlascrea.ma</a>
              </div>
            </div>
            <!-- Phone -->
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-full bg-blue/10 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4 text-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div>
                <p class="text-[10px] font-mono uppercase tracking-[0.2em] text-muted">Téléphone</p>
                <a href="tel:+212XXXXXXXXX" class="text-white hover:text-sky transition-colors font-dm font-light text-sm">+212 XXXXXXXXX</a>
              </div>
            </div>
            <!-- Address -->
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-full bg-blue/10 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4 text-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <p class="text-[10px] font-mono uppercase tracking-[0.2em] text-muted">Adresse</p>
                <p class="text-muted font-dm font-light text-sm">Marrakech, Maroc</p>
              </div>
            </div>
          </div>

          <!-- Social -->
          <div class="mb-12">
            <p class="text-[10px] font-mono uppercase tracking-[0.2em] text-muted mb-4">Suivez-nous</p>
            <div class="flex gap-3">
              <a href="#" target="_blank" class="w-10 h-10 rounded-full border border-border flex items-center justify-center hover:border-sky hover:bg-sky/10 transition-all duration-300">
                <svg class="w-4 h-4 text-muted hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 1.366.062 2.633.336 3.608 1.311.975.975 1.249 2.242 1.311 3.608.058 1.266.07 1.646.07 4.85s-.012 3.584-.07 4.85c-.062 1.366-.336 2.633-1.311 3.608-.975.975-2.242 1.249-3.608 1.311-1.266.058-1.646.07-4.85.07s-3.584-.012-4.85-.07c-1.366-.062-2.633-.336-3.608-1.311-.975-.975-1.249-2.242-1.311-3.608C2.175 15.584 2.163 15.204 2.163 12s.012-3.584.07-4.85c.062-1.366.336-2.633 1.311-3.608.975-.975 2.242-1.249 3.608-1.311C8.416 2.175 8.796 2.163 12 2.163z"/></svg>
              </a>
              <a href="#" target="_blank" class="w-10 h-10 rounded-full border border-border flex items-center justify-center hover:border-sky hover:bg-sky/10 transition-all duration-300">
                <svg class="w-4 h-4 text-muted hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </a>
              <a href="#" target="_blank" class="w-10 h-10 rounded-full border border-border flex items-center justify-center hover:border-sky hover:bg-sky/10 transition-all duration-300">
                <svg class="w-4 h-4 text-muted hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/></svg>
              </a>
            </div>
          </div>

          <!-- WhatsApp -->
          <a href="https://wa.me/212XXXXXXXXX?text=Bonjour%20ATLAS%20CREA%20!%20J%27aimerais%20avoir%20plus%20d%27informations" target="_blank"
             class="flex items-center gap-4 p-4 border border-border hover:border-teal/30 hover:bg-teal/5 transition-all duration-300 group">
            <div class="w-10 h-10 rounded-full bg-teal/10 flex items-center justify-center">
              <svg class="w-4 h-4 text-teal" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/></svg>
            </div>
            <div>
              <p class="text-white font-syne font-bold text-sm">WhatsApp Direct</p>
              <p class="text-muted text-[10px] font-mono uppercase tracking-[0.1em]">Réponse sous 24h</p>
            </div>
            <span class="ml-auto text-muted group-hover:text-teal transition-colors">→</span>
          </a>
        </div>
      </div>

      <!-- Map -->
      <div class="mt-16 border border-border overflow-hidden h-64">
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d67801.89592019959!2d-8.02856454327392!3d31.64139080015985!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xdafee8d96179e51%3A0x4b9c5b3d7b5f7b9f!2sMarrakech!5e0!3m2!1sfr!2sma!4v1" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>

  <!-- ═══════ CTA ═══════ -->
  <section class="py-24 lg:py-32 section-alt-8 section-divider">
    <div class="max-w-3xl mx-auto px-6 lg:px-12 text-center">
      <p class="text-[11px] font-mono uppercase tracking-[0.2em] text-blue mb-4">Urgent ?</p>
      <h2 class="font-syne font-extrabold text-[clamp(2rem,6vw,4rem)] leading-[0.95] tracking-[-0.03em] text-white mb-6">
        Contactez-nous <span class="text-sky">directement</span>
      </h2>
      <p class="text-muted font-dm font-light text-sm sm:text-base max-w-lg mx-auto mb-10">
        Réponse garantie sous 24h ouvrées.
      </p>
      <a href={base + "contact"} class="btn-primary">Envoyer un message →</a>
    </div>
  </section>

</Layout>
