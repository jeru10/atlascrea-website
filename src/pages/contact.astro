---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact — ATLAS CREA | Agence de Communication 360°" description="Contactez ATLAS CREA à Marrakech. Demandez un devis gratuit pour votre projet de communication digitale.">

  <!-- Hero -->
  <section class="pt-32 pb-20 gradient-hero relative overflow-hidden">
    <div class="absolute top-1/3 left-1/4 w-96 h-96 rounded-full bg-brand-cyan/10 blur-[120px]"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <h1 class="text-4xl sm:text-6xl font-bold text-white mb-6">Parlons de votre <span class="gradient-text">projet</span></h1>
      <p class="text-xl text-white/60 max-w-2xl mx-auto">Une idée, un projet ? Remplissez le formulaire et nous vous répondons sous 24h.</p>
    </div>
  </section>

  <!-- Contact Form + Info -->
  <section class="py-20 bg-brand-navy">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row gap-12 lg:gap-20">
        <!-- Form -->
        <div class="flex-1 section-fade">
          <form id="contact-form" class="glass rounded-3xl p-8 md:p-10 space-y-6" data-netlify="true" name="contact">
            <input type="hidden" name="form-name" value="contact" />
            <div>
              <label class="text-white/70 text-sm font-medium block mb-2">Nom complet</label>
              <input type="text" name="name" required class="input-field" placeholder="Votre nom" />
            </div>
            <div>
              <label class="text-white/70 text-sm font-medium block mb-2">Email</label>
              <input type="email" name="email" required class="input-field" placeholder="votre@email.com" />
            </div>
            <div>
              <label class="text-white/70 text-sm font-medium block mb-2">Téléphone</label>
              <input type="tel" name="phone" class="input-field" placeholder="+212 6 XX XX XX XX" />
            </div>
            <div>
              <label class="text-white/70 text-sm font-medium block mb-2">Service souhaité</label>
              <select name="service" class="input-field">
                <option value="" class="bg-brand-navy">Sélectionnez un service</option>
                <option value="branding" class="bg-brand-navy">Branding & Identité</option>
                <option value="web" class="bg-brand-navy">Création de Sites Web</option>
                <option value="social" class="bg-brand-navy">Social Media & Contenu</option>
                <option value="print" class="bg-brand-navy">Print & Supports Physiques</option>
                <option value="seo" class="bg-brand-navy">SEO & Référencement</option>
                <option value="ads" class="bg-brand-navy">Publicité Digitale</option>
                <option value="other" class="bg-brand-navy">Autre</option>
              </select>
            </div>
            <div>
              <label class="text-white/70 text-sm font-medium block mb-2">Message</label>
              <textarea name="message" rows="5" required class="input-field resize-none" placeholder="Décrivez votre projet..."></textarea>
            </div>
            <button type="submit" class="btn-primary w-full text-center text-base !py-4">
              Envoyer le message
            </button>
          </form>
        </div>

        <!-- Contact Info -->
        <div class="flex-1 space-y-6 section-fade">
          <div class="glass rounded-2xl p-8">
            <h3 class="text-xl font-bold text-white mb-6">Coordonnées</h3>
            <div class="space-y-5">
              <div class="flex gap-4">
                <div class="w-10 h-10 rounded-xl bg-brand-purple/20 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-brand-purple" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                </div>
                <div>
                  <p class="text-white/40 text-xs mb-1">Email</p>
                  <a href="mailto:contact@atlascrea.com" class="text-white hover:text-brand-cyan transition-colors">contact@atlascrea.com</a>
                </div>
              </div>
              <div class="flex gap-4">
                <div class="w-10 h-10 rounded-xl bg-brand-cyan/20 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-brand-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                </div>
                <div>
                  <p class="text-white/40 text-xs mb-1">Téléphone</p>
                  <a href="tel:+212605048514" class="text-white hover:text-brand-cyan transition-colors">+212 6 05 04 85 14</a>
                </div>
              </div>
              <div class="flex gap-4">
                <div class="w-10 h-10 rounded-xl bg-brand-blue/20 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                </div>
                <div>
                  <p class="text-white/40 text-xs mb-1">Adresse</p>
                  <p class="text-white">Marrakech, Maroc</p>
                </div>
              </div>
            </div>
          </div>

          <div class="glass rounded-2xl p-8">
            <h3 class="text-xl font-bold text-white mb-6">Suivez-nous</h3>
            <div class="flex gap-3">
              <a href="https://facebook.com/atlascrea" target="_blank" rel="noopener" class="w-12 h-12 rounded-xl bg-white/5 flex items-center justify-center hover:bg-brand-purple/30 hover:scale-110 transition-all duration-300">
                <svg class="w-5 h-5 text-white/80" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>
              <a href="https://instagram.com/atlascrea" target="_blank" rel="noopener" class="w-12 h-12 rounded-xl bg-white/5 flex items-center justify-center hover:bg-brand-purple/30 hover:scale-110 transition-all duration-300">
                <svg class="w-5 h-5 text-white/80" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12s.015 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.988 8.74 24 12 24s3.667-.015 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.012 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227-.224.562-.479.96-.899 1.382-.419.419-.824.679-1.38.896-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421-.569-.224-.96-.479-1.379-.899-.421-.419-.69-.824-.9-1.38-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06l.045.03zm0 3.678c-3.405 0-6.162 2.76-6.162 6.162 0 3.405 2.76 6.162 6.162 6.162 3.405 0 6.162-2.76 6.162-6.162 0-3.405-2.76-6.162-6.162-6.162zM12 16c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm7.846-10.405c0 .795-.646 1.44-1.44 1.44-.795 0-1.44-.646-1.44-1.44 0-.794.646-1.439 1.44-1.439.793-.001 1.44.645 1.44 1.439z"/></svg>
              </a>
              <a href="https://linkedin.com/company/atlascrea" target="_blank" rel="noopener" class="w-12 h-12 rounded-xl bg-white/5 flex items-center justify-center hover:bg-brand-purple/30 hover:scale-110 transition-all duration-300">
                <svg class="w-5 h-5 text-white/80" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </a>
            </div>
          </div>

          <!-- WhatsApp direct link -->
          <a href="https://wa.me/212605048514?text=Bonjour%20ATLAS%20CREA%20!%20J%27aimerais%20avoir%20plus%20d%27informations" target="_blank" rel="noopener" class="glass rounded-2xl p-8 flex items-center gap-4 hover:bg-green-500/10 transition-all duration-300 card-3d group">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-green-400 to-green-600 flex items-center justify-center">
              <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </div>
            <div>
              <p class="text-white font-bold group-hover:text-green-400 transition-colors">WhatsApp Direct</p>
              <p class="text-white/40 text-sm">Réponse sous 24h</p>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Map -->
  <section class="pb-20 bg-brand-navy">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 section-fade">
      <div class="glass rounded-3xl overflow-hidden h-[300px] md:h-[400px]">
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d108895.2298786946!2d-8.066571!3d31.6342705!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xdafee8b9c6f4b8d%3A0x8f0c3d8c9d8e9f0!2sMarrakech%2C%20Morocco!5e0!3m2!1sfr!2s!4v1!4m3!3m2!1sen!2sma" 
          width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
          title="ATLAS CREA Marrakech">
        </iframe>
      </div>
    </div>
  </section>

  <script>
    // Form handler
    document.getElementById('contact-form')?.addEventListener('submit', function(e) {
      const btn = this.querySelector('button[type="submit"]');
      btn.textContent = 'Envoi en cours...';
      btn.disabled = true;
      // Netlify handles it natively, but we can show feedback
      setTimeout(() => {
        btn.textContent = 'Message envoyé ✓';
        btn.style.background = 'linear-gradient(135deg, #059669, #10B981)';
      }, 1000);
    });
  </script>
</Layout>
