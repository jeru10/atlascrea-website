---
import Layout from '../layouts/Layout.astro';
const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');

const plans = [
  { name: 'Starter', price: '2 500', desc: "Idéal pour démarrer votre présence digitale avec l'essentiel.", featured: false, features: ['Logo professionnel', 'Carte de visite', 'Page Facebook / Instagram', 'Pack de 10 posts', 'Livraison en 7 jours'] },
  { name: 'Grow', price: '5 500', desc: "Pour les entreprises prêtes à accélérer leur croissance.", featured: true, features: ['Tout Starter inclus', 'Identité visuelle complète', 'Landing page professionnelle', 'Gestion réseaux sociaux (1 mois)', 'Stratégie de contenu', 'Support prioritaire'] },
  { name: 'Full Presence', price: '9 500', desc: "La solution complète pour une présence digitale de A à Z.", featured: false, features: ['Tout Grow inclus', 'Site web complet', 'Campagne Meta Ads', 'Vidéo promotionnelle', 'Design extérieur (enseigne/banderole)', 'Gestion réseaux sociaux (3 mois)', 'Suivi & reporting mensuel'] },
];
---

<Layout title="Pricing — ATLAS CREA | Nos Offres" description="Découvrez nos formules : Starter, Grow et Full Presence. Solutions adaptées à tous les budgets.">
  <div class="noise-overlay"></div>

  <!-- Hero -->
  <section class="pt-36 pb-20 bg-brand-navy relative overflow-hidden">
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-brand-cyan/5 blur-[120px] rounded-full"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="section-label">TARIFS</div>
      <h1 class="text-[clamp(2.5rem,8vw,5rem)] font-kanit font-bold leading-[0.95] text-white mb-6">
        Des offres <span class="gradient-text">adaptées.</span>
      </h1>
      <p class="text-white/50 text-lg max-w-2xl">Des formules flexibles pour accompagner votre croissance, quel que soit votre budget.</p>
    </div>
  </section>

  <!-- Pricing Grid -->
  <section class="py-20 bg-surface-alt">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-3 gap-6 stagger-children">
        {plans.map((plan, i) => (
          <div class={`pricing-card ${plan.featured ? 'featured' : ''}`} style={{ transitionDelay: `${i * 0.1}s` }}>
            {plan.featured && <div class="inline-block px-3 py-1 rounded-full bg-gradient-to-r from-brand-purple to-brand-cyan text-[10px] font-bold text-white uppercase tracking-widest mb-4">Populaire</div>}
            <h3 class="text-lg font-kanit font-bold text-white mb-2">{plan.name}</h3>
            <p class="text-white/40 text-sm mb-6">{plan.desc}</p>
            <div class="mb-8">
              <span class="text-4xl md:text-5xl font-kanit font-bold gradient-text">{plan.price}</span>
              <span class="text-white/30 text-sm ml-1">MAD</span>
            </div>
            <ul class="space-y-3 mb-10">
              {plan.features.map((f) => (
                <li class="flex items-start gap-3 text-sm text-white/50">
                  <svg class="w-4 h-4 text-brand-cyan mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  {f}
                </li>
              ))}
            </ul>
            <a href={base + "contact"} class={`w-full text-center py-3 rounded-full font-semibold text-sm transition-all duration-300 block ${plan.featured ? 'bg-gradient-to-r from-brand-purple to-brand-blue text-white hover:shadow-lg hover:shadow-brand-purple/30' : 'border border-white/20 text-white hover:bg-white/5'}`}>
              Choisir cette formule
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
