---
import Layout from '../layouts/Layout.astro';
const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');

const services = [
  { index: '/01', name: 'Branding & Identité Visuelle', cat: 'Identité', desc: 'Stratégie de marque, logo, charte graphique, packaging' },
  { index: '/02', name: 'Sites Web & Landing Pages', cat: 'Digital', desc: 'Sites vitrines, e-commerce, landing pages optimisées' },
  { index: '/03', name: 'Social Media & Contenu', cat: 'Social', desc: 'Gestion Instagram/Facebook, création de posts & reels' },
  { index: '/04', name: 'Publicité Digitale', cat: 'Ads', desc: 'Meta Ads, Google Ads, tracking & optimisation' },
  { index: '/05', name: 'Vidéo & Motion Design', cat: 'Motion', desc: 'Reels, spots publicitaires, motion design' },
  { index: '/06', name: 'Design & Impression', cat: 'Print', desc: 'Flyers, brochures, panneaux, cartes de visite' },
];

const portfolioItems = [
  { name: 'Munich Recruitment', cat: 'Recrutement', tags: ['React', 'TypeScript', 'Tailwind'], image: 'https://images.unsplash.com/photo-1486312338219-ce68d2c6f44d?w=800&q=80', url: 'https://www.munichrecruitment.com' },
  { name: 'Abdol Luxury Tour', cat: 'Tourisme', tags: ['Webflow', 'JS', 'Custom CMS'], image: 'https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?w=800&q=80', url: 'https://abdoluxurytour.com' },
  { name: 'Mondrap', cat: 'Mode', tags: ['Shopify', 'Liquid', 'Alpine'], image: 'https://images.unsplash.com/photo-1445205170230-053b83016050?w=800&q=80', url: 'https://mondrap.com' },
  { name: 'Potentiel Consulting', cat: 'Conseil', tags: ['WordPress', 'Elementor', 'PHP'], image: 'https://images.unsplash.com/photo-1559136555-9303baea8ebd?w=800&q=80', url: 'https://www.potentielconsulting.ma' },
  { name: 'Atlas Epic Trek', cat: 'Aventure', tags: ['Next.js', 'Tailwind', 'Vercel'], image: 'https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=800&q=80', url: 'https://atlasepictrek.com' },
  { name: 'Charpente Maroc', cat: 'Construction', tags: ['WordPress', 'Custom Theme'], image: 'https://images.unsplash.com/photo-1541888946425-d81bb6f0aa76?w=800&q=80', url: 'https://charpente-maroc.com' },
];

const processSteps = [
  { number: '01', title: 'Découverte', desc: 'On écoute votre business, vos objectifs et votre vision.' },
  { number: '02', title: 'Stratégie', desc: 'On construit un plan créatif adapté à votre marché.' },
  { number: '03', title: 'Création', desc: 'Notre équipe produit vos livrables avec attention aux détails.' },
  { number: '04', title: 'Lancement', desc: 'On déploie, on publie, on lance — et on reste disponibles.' },
];

const teamMembers = [
  { name: 'Yassine', role: 'Fondateur & Directeur Créatif', kpi: '120+', kpiLabel: 'PROJETS', image: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&q=80' },
  { name: 'Sara', role: 'Cheffe de Projet', kpi: '97%', kpiLabel: 'SATISFACTION', image: 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=400&q=80' },
  { name: 'Omar', role: 'Designer UI/UX', kpi: '89%', kpiLabel: 'RÉTENTION', image: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=400&q=80' },
  { name: 'Imane', role: 'Social Media Manager', kpi: '3.4x', kpiLabel: 'ENGAGEMENT', image: 'https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=400&q=80' },
];

const testimonials = [
  { text: "Une équipe créative et professionnelle. Notre site a été livré dans les délais et dépasse nos attentes.", name: "Karim B.", company: "Munich Recruitment" },
  { text: "ATLAS CREA a transformé notre présence digitale. Résultats mesurables en moins de 3 mois.", name: "Sofia E.", company: "Potentiel Consulting" },
  { text: "Leur approche stratégique nous a aidés à clarifier notre message. Un vrai partenariat.", name: "Younes A.", company: "Atlas Epic Trek" },
];

const faqs = [
  { q: 'Combien de temps pour créer un site web ?', a: 'En moyenne 2 à 4 semaines — de la stratégie au déploiement. Nous travaillons en cycles agiles pour des résultats rapides.' },
  { q: 'Quels sont vos délais de réponse ?', a: 'Sous 24h maximum. Nous privilégions une communication fluide et réactive avec nos clients.' },
  { q: 'Proposez-vous des abonnements mensuels ?', a: 'Oui, après la phase de création nous proposons des formules de maintenance et de gestion continue.' },
  { q: 'Quels sont vos tarifs ?', a: 'Nos projets débutent à 5 000 DH pour un site vitrine. Contactez-nous pour un devis personnalisé.' },
  { q: 'Travaillez-vous avec des clients hors Maroc ?', a: 'Absolument. Nous collaborons à distance avec des clients en Europe, Afrique et Moyen-Orient.' },
];
---

<Layout title="ATLAS CREA — Studio Créatif à Marrakech" description="ATLAS CREA, agence de communication 360° à Marrakech. Branding, sites web, social media, SEO, publicité, print.">

  <!-- ═══════════════════ HERO ═══════════════════ -->
  <section id="hero" class="relative min-h-screen flex flex-col justify-center overflow-hidden bg-bg">
    <!-- Background layers -->
    <div class="hero-mesh"></div>
    <div class="hero-grain"></div>
    <div class="hero-scanlines"></div>
    <div class="hero-glow"></div>

    <div class="relative z-10 w-full max-w-7xl mx-auto px-6 lg:px-12 py-32 md:py-40 flex-1 flex items-center">
      <div class="w-full">
        <!-- Top row: tag + clock -->
        <div class="hero-reveal" data-delay="0.8">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-8">
            <div class="flex items-center gap-3">
              <span class="w-1.5 h-1.5 rounded-full bg-teal"></span>
              <span class="text-[11px] font-mono uppercase tracking-[0.2em] text-muted">ATLAS CREA / MARRAKECH</span>
            </div>
            <span class="text-[11px] font-mono tracking-wider text-muted" id="live-clock">--:--:-- UTC+1 MARRAKECH</span>
          </div>
        </div>

        <!-- Section label -->
        <div class="hero-reveal" data-delay="0.9">
          <span class="text-[11px] font-mono tracking-[0.25em] text-teal mb-4 block">// 00.01°</span>
        </div>

        <!-- H1: Word-by-word reveal -->
        <h1 class="font-syne font-extrabold text-[clamp(3.5rem,9vw,7rem)] leading-[0.9] tracking-[-0.03em] text-white max-w-6xl mb-6">
          <span class="word-reveal" data-delay="1.0"><span>Des</span></span>{' '}
          <span class="word-reveal" data-delay="1.06"><span>identités</span></span>{' '}
          <span class="word-reveal text-teal italic" data-delay="1.12"><span>digitales</span></span>{' '}
          <span class="word-reveal" data-delay="1.18"><span>qui</span></span>{' '}
          <span class="word-reveal" data-delay="1.24"><span>marquent.</span></span>
        </h1>

        <!-- Subtitle -->
        <p class="hero-reveal text-muted text-sm sm:text-base font-dm font-light max-w-2xl mb-10" data-delay="1.4">
          Branding · Sites Web · Social Media · SEO · Publicité · Print
        </p>

        <!-- Buttons -->
        <div class="hero-reveal flex flex-col sm:flex-row items-start sm:items-center gap-4" data-delay="1.6">
          <a href={base + "portfolio"} class="btn-primary">Voir nos réalisations →</a>
          <a href={base + "contact"} class="btn-outline">Démarrer un projet</a>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute right-8 bottom-8 hidden lg:flex flex-col items-center gap-3 z-10">
      <span class="text-[10px] font-mono tracking-[0.2em] text-muted vertical-rl" style="writing-mode: vertical-rl;">SCROLL</span>
      <div class="w-px h-16 bg-gradient-to-b from-muted to-transparent"></div>
    </div>
  </section>

  <!-- ═══════════════════ MARQUEE ROW 1 ═══════════════════ -->
  <div class="marquee py-3" style="background: #3654E3;">
    <div class="marquee-inner text-[11px] font-syne font-bold uppercase tracking-[0.2em]" style="color: #020E26;">
      <span>Branding</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>Sites Web</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>Social Media</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>SEO</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>Motion Design</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>Publicité</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>Print</span><span class="marquee-dot" style="background:#020E26;"></span>
      <!-- Duplicate for seamless loop -->
      <span>Branding</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>Sites Web</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>Social Media</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>SEO</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>Motion Design</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>Publicité</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>Print</span><span class="marquee-dot" style="background:#020E26;"></span>
    </div>
  </div>

  <!-- ═══════════════════ MARQUEE ROW 2 ═══════════════════ -->
  <div class="marquee py-3" style="background: rgba(240,238,232,0.03);">
    <div class="marquee-inner marquee-inner-right text-[11px] font-mono tracking-wider" style="color: rgba(240,238,232,0.45);">
      <span>Marrakech</span><span class="marquee-dot" style="background:rgba(240,238,232,0.45);"></span>
      <span>120+ Projets Livrés</span><span class="marquee-dot" style="background:rgba(240,238,232,0.45);"></span>
      <span>99% Satisfaction</span><span class="marquee-dot" style="background:rgba(240,238,232,0.45);"></span>
      <span>3+ Ans</span><span class="marquee-dot" style="background:rgba(240,238,232,0.45);"></span>
      <span>4.9★ Avis Clients</span><span class="marquee-dot" style="background:rgba(240,238,232,0.45);"></span>
      <!-- Duplicate -->
      <span>Marrakech</span><span class="marquee-dot" style="background:rgba(240,238,232,0.45);"></span>
      <span>120+ Projets Livrés</span><span class="marquee-dot" style="background:rgba(240,238,232,0.45);"></span>
      <span>99% Satisfaction</span><span class="marquee-dot" style="background:rgba(240,238,232,0.45);"></span>
      <span>3+ Ans</span><span class="marquee-dot" style="background:rgba(240,238,232,0.45);"></span>
      <span>4.9★ Avis Clients</span><span class="marquee-dot" style="background:rgba(240,238,232,0.45);"></span>
    </div>
  </div>

  <!-- ═══════════════════ STUDIO SECTION ═══════════════════ -->
  <section class="py-28 md:py-36 bg-bg relative overflow-hidden border-t border-border">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="section-label scroll-fade">01 / STUDIO CRÉATIF</div>
      <div class="grid md:grid-cols-5 gap-12 md:gap-16 items-start mt-8">
        <div class="md:col-span-3 scroll-fade-left">
          <h2 class="section-title text-[clamp(2.5rem,5vw,4rem)] max-w-3xl">
            Une vision distincte<br />
            <span class="relative inline-block">à chaque projet.
              <span class="absolute -bottom-2 left-0 right-0 h-px bg-teal"></span>
            </span>
          </h2>
        </div>
        <div class="md:col-span-2 scroll-fade-right">
          <p class="text-muted text-base leading-relaxed mb-8 font-dm font-light">
            Studio basé à Marrakech. Nous construisons des identités digitales où la stratégie rencontre l'expression créative. Chaque projet est unique, chaque solution sur mesure.
          </p>
          <a href={base + "about"} class="inline-flex items-center gap-2 text-[11px] font-syne font-bold tracking-[0.15em] uppercase text-white hover:text-teal transition-colors">
            En savoir plus →
          </a>
        </div>
      </div>
      <div class="mt-20 h-px w-full bg-border"></div>
    </div>
  </section>

  <!-- ═══════════════════ SERVICES ═══════════════════ -->
  <section class="py-28 md:py-36 bg-bg relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 60% 40% at 50% 100%, rgba(54,84,227,0.06) 0%, transparent 60%);"></div>
    <div class="max-w-7xl mx-auto px-6 lg:px-12 relative z-10">
      <div class="scroll-fade mb-16">
        <div class="section-label">02 / PRESTATIONS</div>
        <h2 class="section-title text-[clamp(2rem,4vw,3rem)] max-w-3xl">Des solutions qui comptent.</h2>
      </div>

      <div class="stagger-reveal">
        {services.map((s, i) => (
          <div class="service-row scroll-fade" style={{ transitionDelay: `${i * 0}s` }}>
            <span class="service-index">{s.index}</span>
            <span class="service-name">{s.name}</span>
            <span class="service-cat hidden sm:block">{s.cat}</span>
            <span class="service-arrow">→</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════ PORTFOLIO ═══════════════════ -->
  <section class="py-28 md:py-36 bg-surface-alt relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="scroll-fade mb-16">
        <div class="section-label">03 / RÉALISATIONS</div>
        <h2 class="section-title text-[clamp(2rem,4vw,3rem)] max-w-3xl">Des créations qui marquent.</h2>
      </div>

      <!-- Asymmetric grid -->
      <div class="stagger-reveal grid grid-cols-1 md:grid-cols-12 gap-4">
        <!-- Row 1: Large + Small -->
        {[0, 1].map((idx) => (
          <a href={portfolioItems[idx].url} target="_blank" rel="noopener" class={`portfolio-card scroll-scale ${idx === 0 ? 'md:col-span-7' : 'md:col-span-5'}`}>
            <img src={portfolioItems[idx].image} alt={portfolioItems[idx].name} />
            <div class="p-5">
              <div class="flex items-center justify-between mb-1">
                <span class="font-syne font-bold text-sm text-white">{portfolioItems[idx].name}</span>
                <span class="text-[10px] font-mono text-muted px-2 py-0.5 border border-border rounded">{portfolioItems[idx].cat}</span>
              </div>
              <div class="flex items-center gap-2 mt-3">
                {portfolioItems[idx].tags.map((t) => (
                  <span class="text-[9px] font-mono uppercase tracking-wider text-muted bg-white/5 px-2 py-1">{t}</span>
                ))}
                <span class="ml-auto text-xs text-muted">→</span>
              </div>
            </div>
          </a>
        ))}
        <!-- Row 2: Small + Large -->
        {[2, 3].map((idx) => (
          <a href={portfolioItems[idx].url} target="_blank" rel="noopener" class={`portfolio-card scroll-scale ${idx === 2 ? 'md:col-span-5' : 'md:col-span-7'}`}>
            <img src={portfolioItems[idx].image} alt={portfolioItems[idx].name} />
            <div class="p-5">
              <div class="flex items-center justify-between mb-1">
                <span class="font-syne font-bold text-sm text-white">{portfolioItems[idx].name}</span>
                <span class="text-[10px] font-mono text-muted px-2 py-0.5 border border-border rounded">{portfolioItems[idx].cat}</span>
              </div>
              <div class="flex items-center gap-2 mt-3">
                {portfolioItems[idx].tags.map((t) => (
                  <span class="text-[9px] font-mono uppercase tracking-wider text-muted bg-white/5 px-2 py-1">{t}</span>
                ))}
                <span class="ml-auto text-xs text-muted">→</span>
              </div>
            </div>
          </a>
        ))}
        <!-- Row 3: Equal -->
        {[4, 5].map((idx) => (
          <a href={portfolioItems[idx].url} target="_blank" rel="noopener" class={`portfolio-card scroll-scale md:col-span-6`}>
            <img src={portfolioItems[idx].image} alt={portfolioItems[idx].name} />
            <div class="p-5">
              <div class="flex items-center justify-between mb-1">
                <span class="font-syne font-bold text-sm text-white">{portfolioItems[idx].name}</span>
                <span class="text-[10px] font-mono text-muted px-2 py-0.5 border border-border rounded">{portfolioItems[idx].cat}</span>
              </div>
              <div class="flex items-center gap-2 mt-3">
                {portfolioItems[idx].tags.map((t) => (
                  <span class="text-[9px] font-mono uppercase tracking-wider text-muted bg-white/5 px-2 py-1">{t}</span>
                ))}
                <span class="ml-auto text-xs text-muted">→</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════ PROCESS ═══════════════════ -->
  <section class="py-28 md:py-36 bg-bg relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="scroll-fade mb-16">
        <div class="section-label">04 / NOTRE PROCESSUS</div>
        <h2 class="section-title text-[clamp(2rem,4vw,3rem)] max-w-3xl">Du concept à la réalité.</h2>
      </div>
      <div class="grid md:grid-cols-4 gap-6 stagger-reveal">
        {processSteps.map((step) => (
          <div class="process-step scroll-fade">
            <div class="process-number">//{step.number}</div>
            <h3 class="font-syne font-bold text-lg text-white mb-3">{step.title}</h3>
            <p class="text-muted text-sm font-dm font-light leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════ STATS ═══════════════════ -->
  <section class="py-28 md:py-36 relative overflow-hidden" style="background: radial-gradient(ellipse 70% 50% at 20% 50%, rgba(26,22,117,0.5) 0%, transparent 60%), radial-gradient(ellipse 40% 60% at 80% 30%, rgba(54,84,227,0.2) 0%, transparent 50%), #020E26;">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="scroll-fade mb-16">
        <div class="section-label">// PERFORMANCE</div>
        <h2 class="section-title text-[clamp(2rem,4vw,3rem)] max-w-3xl">La preuve derrière notre travail.</h2>
      </div>
      <div class="stats-grid stagger-reveal">
        <div class="stats-box scroll-fade">
          <span class="stats-index">//001</span>
          <div class="stats-number count-up" data-count="120" data-suffix="+">0+</div>
          <div class="text-[11px] font-mono text-muted uppercase tracking-widest mt-2">Projets livrés</div>
        </div>
        <div class="stats-box scroll-fade">
          <span class="stats-index">//002</span>
          <div class="stats-number count-up" data-count="99" data-suffix="%">0%</div>
          <div class="text-[11px] font-mono text-muted uppercase tracking-widest mt-2">Satisfaction client</div>
        </div>
        <div class="stats-box scroll-fade">
          <span class="stats-index">//003</span>
          <div class="stats-number count-up" data-count="3" data-suffix="+">0+</div>
          <div class="text-[11px] font-mono text-muted uppercase tracking-widest mt-2">Ans d'expérience</div>
        </div>
        <div class="stats-box scroll-fade">
          <span class="stats-index">//004</span>
          <div class="stats-number count-up" data-count="4.9" data-suffix="★">0★</div>
          <div class="text-[11px] font-mono text-muted uppercase tracking-widest mt-2">Avis clients</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ TEAM ═══════════════════ -->
  <section class="py-28 md:py-36 bg-bg relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="scroll-fade mb-16">
        <div class="section-label">05 / L'ÉQUIPE</div>
        <h2 class="section-title text-[clamp(2rem,4vw,3rem)] max-w-3xl">Pas de visages sérieux. Un vrai travail sérieux.</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 stagger-reveal">
        {teamMembers.map((member) => (
          <div class="scroll-fade">
            <div class="aspect-square rounded-xl overflow-hidden bg-border mb-4">
              <img src={member.image} alt={member.name} class="team-photo w-full h-full object-cover" loading="lazy" />
            </div>
            <p class="font-syne font-bold text-sm text-white">{member.name}</p>
            <p class="text-[11px] font-mono text-muted mt-1">{member.role}</p>
            <div class="flex items-center justify-between mt-3 pt-3 border-t border-border">
              <span class="text-lg font-syne font-bold text-white">{member.kpi}</span>
              <span class="text-[9px] font-mono text-muted tracking-widest">{member.kpiLabel}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════ FAQ ═══════════════════ -->
  <section class="py-28 md:py-36 bg-[#030F30] relative overflow-hidden">
    <div class="max-w-3xl mx-auto px-6 lg:px-12">
      <div class="scroll-fade mb-16 text-center">
        <div class="section-label">FAQ</div>
        <h2 class="section-title text-[clamp(2rem,4vw,3rem)]">Des doutes ? Des réponses.</h2>
      </div>
      <div class="stagger-reveal">
        {faqs.map((faq) => (
          <div class="faq-item scroll-fade">
            <div class="faq-question">
              <span>{faq.q}</span>
              <span class="faq-icon">+</span>
            </div>
            <div class="faq-answer">
              <p class="text-muted text-sm font-dm font-light leading-relaxed">{faq.a}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════ TESTIMONIALS ═══════════════════ -->
  <section class="py-28 md:py-36 bg-bg relative overflow-hidden border-t border-border">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="scroll-fade mb-16">
        <div class="section-label">06 / TÉMOIGNAGES</div>
        <h2 class="section-title text-[clamp(2rem,4vw,3rem)] max-w-3xl">Ce qu'ils disent de nous.</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-8 stagger-reveal">
        {testimonials.map((t) => (
          <div class="scroll-fade p-8 border border-border" style="border-radius: 0;">
            <p class="text-muted text-sm font-dm font-light leading-relaxed mb-6 italic">"{t.text}"</p>
            <div>
              <p class="font-syne font-bold text-sm text-white">{t.name}</p>
              <p class="text-[10px] font-mono text-muted uppercase tracking-wider mt-1">{t.company}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════ CTA ═══════════════════ -->
  <section class="py-28 md:py-36 bg-bg relative overflow-hidden border-t border-border">
    <div class="max-w-4xl mx-auto px-6 lg:px-12 text-center">
      <div class="scroll-fade">
        <div class="section-label">// CONTACT</div>
        <h2 class="section-title text-[clamp(2.5rem,5vw,4rem)] max-w-4xl mx-auto mb-8">
          Prêt à créer quelque chose<br />de <span class="text-teal">grand</span> ?
        </h2>
        <p class="text-muted text-base max-w-lg mx-auto mb-10 font-dm font-light">
          Discutons de votre projet et trouvons ensemble la meilleure solution pour votre marque.
        </p>
        <a href={base + "contact"} class="btn-primary text-base !px-12 !py-5">
          C'est parti ! →
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════ CLOCK SCRIPT ═══════ -->
  <script>
    function updateClock() {
      var opts = { timeZone: 'Africa/Casablanca', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false };
      var el = document.getElementById('live-clock');
      if (el) el.textContent = new Intl.DateTimeFormat('fr-FR', opts).format(new Date()) + ' UTC+1 MARRAKECH';
    }
    updateClock();
    setInterval(updateClock, 1000);
  </script>
</Layout>
