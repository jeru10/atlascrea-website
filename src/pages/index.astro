---
import Layout from '../layouts/Layout.astro';
const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');

const servicesList = [
  { number: '01', title: 'Branding & Identité Visuelle', desc: 'Créez une marque mémorable qui se démarque.', items: ['Logo & charte graphique', 'Carte de visite & papeterie', 'Guide de marque complet'] },
  { number: '02', title: 'Social Media & Contenu', desc: 'Votre présence digitale, gérée avec stratégie.', items: ['Gestion Instagram / Facebook', 'Création de posts & reels', 'Stratégie de contenu'] },
  { number: '03', title: 'Sites Web & Landing Pages', desc: 'Des sites web qui convertissent vos visiteurs.', items: ['Landing page professionnelle', 'Site vitrine & catalogue', 'Optimisation SEO'] },
  { number: '04', title: 'Publicité & Ads', desc: 'Atteignez vos clients là où ils se trouvent.', items: ['Meta Ads (Facebook / Instagram)', 'Google Ads', 'Suivi & optimisation'] },
  { number: '05', title: 'Vidéo & Motion', desc: "Captez l'attention avec des visuels en mouvement.", items: ['Reels & stories animées', 'Spots publicitaires', 'Motion design & animations'] },
  { number: '06', title: 'Design & Impression', desc: 'Votre marque, visible partout.', items: ['Design intérieur & extérieur', 'Panneaux, banderoles, enseignes', 'Flyers, brochures, menus'] },
];

const portfolioWebsites = [
  { name: "Munich Recruitment", url: "https://www.munichrecruitment.com", cat: "Recrutement", image: "images/portfolio/munich-recruitment.jpg" },
  { name: "Abdol Luxury Tour", url: "https://abdoluxurytour.com", cat: "Tourisme de luxe", image: "images/portfolio/abdoluxurytour.jpg" },
  { name: "Mondrap", url: "https://mondrap.com", cat: "Mode & Vêtements", image: "images/portfolio/mondrap.jpg" },
  { name: "Potentiel Consulting", url: "https://www.potentielconsulting.ma", cat: "Conseil & Consulting", image: "images/portfolio/potentiel-consulting.jpg" },
  { name: "Atlas Epic Trek", url: "https://atlasepictrek.com", cat: "Trekking & Aventure", image: "images/portfolio/atlasepictrek.jpg" },
  { name: "Charpente Maroc", url: "https://charpente-maroc.com", cat: "Construction Bois", image: "images/portfolio/charpente-maroc.jpg" },
];

const processSteps = [
  { number: '01', title: 'Découverte', desc: "On écoute votre business, vos objectifs et votre vision. Appel ou DM — simple et rapide.", gradient: 'from-purple-500/20 to-transparent' },
  { number: '02', title: 'Stratégie', desc: "On construit un plan créatif adapté à votre marché et votre budget.", gradient: 'from-cyan-500/20 to-transparent' },
  { number: '03', title: 'Création', desc: "Notre équipe produit vos livrables avec attention aux détails et à la qualité.", gradient: 'from-blue-500/20 to-transparent' },
  { number: '04', title: 'Lancement', desc: "On déploie, on publie, on lance — et on reste disponibles pour le suivi.", gradient: 'from-purple-500/20 to-transparent' },
];

const pricingPlans = [
  { name: 'Starter', price: '2 500', desc: "Idéal pour démarrer votre présence digitale avec l'essentiel.", featured: false, features: ['Logo professionnel', 'Carte de visite', 'Page Facebook / Instagram', 'Pack de 10 posts', 'Livraison en 7 jours'] },
  { name: 'Grow', price: '5 500', desc: "Pour les entreprises prêtes à accélérer leur croissance.", featured: true, features: ['Tout ce qui est dans Starter', 'Identité visuelle complète', 'Landing page professionnelle', 'Gestion réseaux sociaux (1 mois)', 'Stratégie de contenu', 'Support prioritaire'] },
  { name: 'Full Presence', price: '9 500', desc: "La solution complète pour une présence digitale de A à Z.", featured: false, features: ['Tout ce qui est dans Grow', 'Site web complet', 'Campagne publicitaire Meta Ads', 'Vidéo promotionnelle', 'Design extérieur (enseigne/banderole)', 'Gestion réseaux sociaux (3 mois)', 'Suivi & reporting mensuel'] },
];

const testimonials = [
  { quote: "ATLAS CREA a transformé notre image de marque. Leur approche créative et professionnelle a dépassé nos attentes. Je recommande vivement !", name: "Sara El Amrani", role: "Fondatrice, Potentiel Consulting", stars: 5 },
  { quote: "Un travail remarquable sur notre site web. L'équipe est à l'écoute, réactive et livre toujours dans les délais. Notre chiffre d'affaires a augmenté de 40%.", name: "Karim Benali", role: "CEO, Munich Recruitment", stars: 5 },
  { quote: "Depuis qu'on travaille avec ATLAS CREA, notre présence sur les réseaux sociaux a explosé. Leur stratégie de contenu est pertinente et créative.", name: "Amina Tazi", role: "Directrice Marketing, Mondrap", stars: 5 },
];
---

<Layout title="ATLAS CREA — Branding · Stratégie · Croissance" description="Studio créatif à Marrakech spécialisé dans le branding, le social media, les sites web, la publicité et le design. Solutions sur-mesure pour votre marque.">
  <!-- Noise overlay -->
  <div class="noise-overlay"></div>

  <main>
    <!-- ═══════════ HERO ═══════════ -->
    <section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-brand-navy">
      <!-- 3D Canvas -->
      <div id="hero-3d" class="absolute inset-0 z-0"></div>

      <!-- Background Gradient -->
      <div class="absolute inset-0 z-[1]">
        <div class="absolute inset-0 bg-gradient-to-b from-brand-navy via-brand-navy/80 to-brand-navy scale-110"></div>
        <div class="absolute inset-x-0 top-0 h-[50%] bg-gradient-to-b from-[#5532E4]/10 via-transparent to-transparent"></div>
        <div class="absolute top-1/4 right-1/4 w-[600px] h-[600px] rounded-full bg-brand-purple/5 blur-[120px]"></div>
        <div class="absolute bottom-1/4 left-1/4 w-[400px] h-[400px] rounded-full bg-brand-cyan/5 blur-[100px]"></div>
      </div>

      <!-- Grid overlay -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        {[1,2,3,4,5,6,7].map((_, i) => (
          <div class="absolute left-0 right-0 h-px bg-white/5" style={{ top: `${12.5 * (i + 1)}%` }}></div>
        ))}
      </div>

      <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-32 md:py-40">
        <div class="max-w-5xl">
          <!-- Hero Heading -->
          <div class="space-y-0 mb-8">
            <h1 class="text-[clamp(3.5rem,12vw,7rem)] font-kanit font-bold leading-[0.88] tracking-tighter text-white">
              <span class="block overflow-hidden">
                <span class="block hero-reveal" style="animation-delay: 0s">Votre</span>
              </span>
              <span class="block overflow-hidden">
                <span class="block hero-reveal gradient-text" style="animation-delay: 0.15s">Présence</span>
              </span>
              <span class="block overflow-hidden">
                <span class="block hero-reveal" style="animation-delay: 0.3s">Digitale</span>
              </span>
              <span class="block overflow-hidden">
                <span class="block hero-reveal" style="animation-delay: 0.45s">Complète.</span>
              </span>
              <span class="block overflow-hidden mt-2">
                <span class="block hero-reveal font-inter text-lg sm:text-xl font-normal tracking-normal text-white/40 max-w-xl" style="animation-delay: 0.6s">
                  Branding · Sites Web · Social Media · SEO · Publicité · Print
                </span>
              </span>
            </h1>
          </div>

          <!-- CTA + Stats row -->
          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6 mt-12 hero-fade" style="animation-delay: 1s">
            <a href={base + "portfolio"} class="btn-primary">
              Voir nos réalisations →
            </a>
            <a href={base + "contact"} class="btn-outline">
              Démarrer un projet
            </a>
          </div>

          <!-- Stats -->
          <div class="flex flex-wrap gap-10 sm:gap-16 mt-16 pt-12 border-t border-white/10 hero-fade" style="animation-delay: 1.2s">
            <div>
              <span class="text-3xl sm:text-4xl font-kanit font-bold gradient-text">120<span class="text-white">+</span></span>
              <p class="text-xs text-white/40 font-mono tracking-widest mt-1 uppercase">Projets livrés</p>
            </div>
            <div>
              <span class="text-3xl sm:text-4xl font-kanit font-bold text-white">99<span class="text-white">%</span></span>
              <p class="text-xs text-white/40 font-mono tracking-widest mt-1 uppercase">Satisfaction client</p>
            </div>
            <div>
              <span class="text-3xl sm:text-4xl font-kanit font-bold text-white">3<span class="text-white">+</span></span>
              <p class="text-xs text-white/40 font-mono tracking-widest mt-1 uppercase">Ans d'expérience</p>
            </div>
            <div>
              <span class="text-3xl sm:text-4xl font-kanit font-bold text-white">4.9<span class="text-brand-cyan">★</span></span>
              <p class="text-xs text-white/40 font-mono tracking-widest mt-1 uppercase">Avis clients</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════ ABOUT / INTRO [01] ═══════════ -->
    <section class="py-24 md:py-32 bg-brand-navy relative overflow-hidden">
      <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-brand-purple/5 blur-[100px] rounded-full"></div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="section-fade">
          <div class="section-label">01 / STUDIO CRÉATIF</div>
          <h2 class="section-title max-w-4xl mb-8">
            Une vision distincte à chaque projet, fusionnant <span class="gradient-text">stratégie + créativité</span> pour des marques audacieuses.
          </h2>
          <p class="text-white/50 text-lg max-w-2xl leading-relaxed mb-12">
            Studio basé à Marrakech. Nous construisons des identités digitales où la stratégie rencontre l'expression — fusionnant créativité et intention pour des résultats concrets.
          </p>
          <a href={base + "about"} class="inline-flex items-center gap-2 text-brand-cyan hover:text-white transition-colors text-sm font-mono uppercase tracking-widest group">
            En savoir plus
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ═══════════ SERVICES [02] ═══════════ -->
    <section class="py-24 md:py-32 bg-brand-navy relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="section-fade">
          <div class="section-label">02 / PRESTATIONS</div>
          <h2 class="section-title max-w-3xl mb-16 md:mb-20">
            Des solutions qui <span class="gradient-text">comptent.</span>
          </h2>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-px bg-white/5">
          {servicesList.map((svc, i) => (
            <div class="service-card section-fade" style={{ transitionDelay: `${i * 0.1}s` }}>
              <div class="flex items-start justify-between mb-6">
                <div class="w-12 h-12 rounded-full bg-gradient-to-br from-brand-purple/20 to-brand-cyan/20 flex items-center justify-center">
                  <span class="font-kanit font-bold gradient-text text-lg">{svc.number}</span>
                </div>
                <span class="text-xs font-mono text-white/20">/{svc.number}</span>
              </div>
              <h3 class="text-xl font-bold text-white mb-3">{svc.title}</h3>
              <p class="text-white/50 text-sm mb-6 leading-relaxed">{svc.desc}</p>
              <ul class="space-y-2">
                {svc.items.map((item) => (
                  <li class="flex items-center gap-2 text-sm text-white/60">
                    <span class="w-1 h-1 rounded-full bg-brand-cyan flex-shrink-0"></span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ WORK / PORTFOLIO [03] ═══════════ -->
    <section class="py-24 md:py-32 bg-brand-navy relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="section-fade">
          <div class="section-label">03 / RÉALISATIONS</div>
          <h2 class="section-title max-w-3xl mb-16 md:mb-20">
            Des créations qui <span class="gradient-text">marquent.</span>
          </h2>
        </div>

        <div class="grid sm:grid-cols-2 gap-6 stagger-children">
          {portfolioWebsites.map((project, i) => (
            <a
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
              class="work-card group"
            >
              <div class="aspect-[16/10] overflow-hidden relative">
                <img
                  src={project.image}
                  alt={project.name}
                  class="w-full h-full object-cover object-top group-hover:scale-110 transition-transform duration-700"
                  loading="lazy"
                />
                <!-- Hover overlay -->
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                <!-- View button -->
                <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-500 scale-90 group-hover:scale-100">
                  <div class="w-16 h-16 rounded-full bg-white text-black flex items-center justify-center shadow-2xl group-hover:rotate-12 transition-transform">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                  </div>
                </div>
                <!-- Badge -->
                <div class="absolute top-4 left-4 z-10">
                  <span class="px-3 py-1 rounded-full bg-black/40 backdrop-blur-md border border-white/10 text-[10px] font-mono uppercase tracking-widest text-white">{project.cat}</span>
                </div>
              </div>
              <div class="p-5 flex items-center justify-between">
                <h3 class="text-base font-kanit font-bold text-white group-hover:text-brand-cyan transition-colors">{project.name}</h3>
                <span class="text-white/20 text-xs font-mono">2025</span>
              </div>
            </a>
          ))}
        </div>

        <div class="text-center mt-12 section-fade">
          <a href={base + "portfolio"} class="btn-outline">
            Voir tous les projets →
          </a>
        </div>
      </div>
    </section>

    <!-- ═══════════ PROCESS [04] ═══════════ -->
    <section class="py-24 md:py-32 bg-brand-navy relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="section-fade mb-16 md:mb-20">
          <div class="section-label">04 / NOTRE PROCESSUS</div>
          <h2 class="section-title max-w-4xl">
            Du concept à la <span class="gradient-text">réalité.</span>
          </h2>
        </div>

        <div class="relative">
          {processSteps.map((step, index) => (
            <div class="sticky top-32 min-h-[40vh] mb-6 last:mb-0" style={{ zIndex: index + 1 }}>
              <div class="process-card relative h-full section-fade">
                <div class="process-accent-line"></div>
                <div class="flex flex-col md:flex-row gap-8 md:gap-16 items-start">
                  <div class="flex-shrink-0">
                    <span class="text-6xl md:text-8xl font-kanit font-bold text-white/5 leading-none">//{step.number}</span>
                  </div>
                  <div class="flex-1 pt-2">
                    <h3 class="text-2xl md:text-3xl font-kanit font-bold text-white mb-4">{step.title}</h3>
                    <p class="text-white/50 text-lg max-w-xl leading-relaxed">{step.desc}</p>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ TESTIMONIALS [05] ═══════════ -->
    <section class="py-24 md:py-32 bg-brand-navy relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="section-fade mb-16 md:mb-20">
          <div class="section-label">05 / TÉMOIGNAGES</div>
          <h2 class="section-title max-w-3xl">
            Ce qu'ils disent <span class="gradient-text">de nous.</span>
          </h2>
        </div>

        <div class="grid md:grid-cols-3 gap-6 stagger-children">
          {testimonials.map((t, i) => (
            <div class="testimonial-card section-fade" style={{ transitionDelay: `${i * 0.1}s` }}>
              <div class="flex gap-1 mb-6">
                {[...Array(t.stars)].map(() => (
                  <svg class="w-4 h-4 text-brand-cyan" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                ))}
              </div>
              <p class="text-white/70 text-sm leading-relaxed mb-8 italic">"{t.quote}"</p>
              <div class="mt-auto">
                <p class="text-white font-semibold text-sm">{t.name}</p>
                <p class="text-white/30 text-xs mt-1">{t.role}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ CTA ═══════════ -->
    <section class="py-24 md:py-32 bg-brand-navy relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-brand-purple/5 via-transparent to-brand-cyan/5"></div>
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
        <div class="section-fade">
          <h2 class="text-4xl sm:text-5xl md:text-7xl font-kanit font-bold text-white leading-[0.95] mb-8">
            Prêt à créer quelque chose<br>de <span class="gradient-text">grand</span> ?
          </h2>
          <p class="text-white/40 text-lg max-w-lg mx-auto mb-10">
            Discutons de votre projet et trouvons ensemble la meilleure solution pour votre marque.
          </p>
          <a href={base + "contact"} class="btn-primary text-base !px-12 !py-5">
            C'est parti ! →
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- 3D Hero Animation (Three.js) -->
  <script>
    import AtlasHero3D from '../components/ThreeBackground.js';

    document.addEventListener('DOMContentLoaded', () => {
      const container = document.getElementById('hero-3d');
      if (container && window.innerWidth > 768) {
        new AtlasHero3D(container);
      } else if (container) {
        // Fallback: subtle gradient animation on mobile
        container.style.background = 'radial-gradient(ellipse at center, rgba(85,50,228,0.1) 0%, transparent 70%)';
      }
    });
  </script>
</Layout>
