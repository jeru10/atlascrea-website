---
import Layout from '../layouts/Layout.astro';
const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');

const portfolioItems = [
  { name: 'Munich Recruitment', cat: 'Recrutement', tags: ['React', 'TypeScript', 'Tailwind'], image: 'https://images.unsplash.com/photo-1486312338219-ce68d2c6f44d?w=800&q=80', url: 'https://www.munichrecruitment.com' },
  { name: 'Abdol Luxury Tour', cat: 'Tourisme', tags: ['Webflow', 'JS', 'Custom CMS'], image: 'https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?w=800&q=80', url: 'https://abdoluxurytour.com' },
  { name: 'Mondrap', cat: 'Mode', tags: ['Shopify', 'Liquid', 'Alpine'], image: 'https://images.unsplash.com/photo-1445205170230-053b83016050?w=800&q=80', url: 'https://mondrap.com' },
  { name: 'Potentiel Consulting', cat: 'Conseil', tags: ['WordPress', 'Elementor', 'PHP'], image: 'https://images.unsplash.com/photo-1559136555-9303baea8ebd?w=800&q=80', url: 'https://www.potentielconsulting.ma' },
  { name: 'Atlas Epic Trek', cat: 'Aventure', tags: ['Next.js', 'Tailwind', 'Vercel'], image: 'https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=800&q=80', url: 'https://atlasepictrek.com' },
  { name: 'Charpente Maroc', cat: 'Construction', tags: ['WordPress', 'Custom Theme'], image: 'https://images.unsplash.com/photo-1541888946425-d81bb6f0aa76?w=800&q=80', url: 'https://charpente-maroc.com' },
];
---

<Layout title="Réalisations — ATLAS CREA | Portfolio" description="Découvrez nos réalisations : sites web, branding et design digital pour nos clients à Marrakech et au Maroc.">

  <!-- ═══════ HERO ═══════ -->
  <section class="relative min-h-[70vh] flex items-center pt-32 pb-20 overflow-hidden bg-bg">
    <div class="absolute inset-0 hero-mesh"></div>
    <div class="hero-grain"></div>
    <div class="hero-scanlines"></div>

    <div class="max-w-7xl mx-auto px-6 lg:px-12 relative z-10">
      <p class="text-[11px] font-mono uppercase tracking-[0.2em] text-muted mb-6">Réalisations</p>
      <h1 class="font-syne font-extrabold text-[clamp(3rem,8vw,6rem)] leading-[0.9] tracking-[-0.03em] text-white max-w-4xl mb-6">
        <span class="word-reveal" data-delay="1.0"><span>Nos</span></span>{' '}
        <span class="word-reveal text-teal italic" data-delay="1.06"><span>projets</span></span>
      </h1>
      <p class="hero-reveal text-muted text-sm sm:text-base font-dm font-light max-w-xl mb-10" data-delay="1.4">
        Chaque projet raconte une histoire. Découvrez nos dernières créations.
      </p>
    </div>

    <div class="absolute right-8 bottom-8 hidden lg:flex flex-col items-center gap-3 z-10">
      <span class="text-[10px] font-mono tracking-[0.2em] text-muted vertical-rl" style="writing-mode: vertical-rl;">PROJETS</span>
      <div class="w-px h-16 bg-gradient-to-b from-muted to-transparent"></div>
    </div>
  </section>

  <!-- ═══════ MARQUEE ═══════ -->
  <div class="marquee py-3" style="background: #3654E3;">
    <div class="marquee-inner text-[11px] font-syne font-bold uppercase tracking-[0.2em]" style="color: #020E26;">
      <span>Web</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>Branding</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>UX/UI</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>E-commerce</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>WordPress</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>Design</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>Motion</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>Web</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>Branding</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>UX/UI</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>E-commerce</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>WordPress</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>Design</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>Motion</span><span class="marquee-dot" style="background:#020E26;"></span>
    </div>
  </div>

  <!-- ═══════ PORTFOLIO GRID ═══════ -->
  <section class="py-24 lg:py-32 bg-bg section-divider">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {portfolioItems.map((item, i) => (
          <a href={item.url} target="_blank" rel="noopener"
             class="portfolio-card group relative overflow-hidden bg-border/10 block"
             class:list={{ 'sm:col-span-2 sm:row-span-2': i === 0 }}>
            <div class="aspect-[4/3] overflow-hidden" class:list={{ 'aspect-[4/3]': i !== 0, 'aspect-[16/10]': i === 0 }}>
              <img src={item.image} alt={item.name}
                   class="w-full h-full object-cover transition-all duration-700 group-hover:scale-105 grayscale group-hover:grayscale-0" />
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-bg/90 via-bg/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex flex-col justify-end p-6">
              <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-sky mb-1">{item.cat}</span>
              <h3 class="font-syne font-bold text-white text-lg">{item.name}</h3>
              <div class="flex flex-wrap gap-2 mt-2">
                {item.tags.map((tag) => (
                  <span class="text-[9px] font-mono uppercase tracking-[0.1em] px-2 py-1 border border-muted-strong/30 text-muted">{tag}</span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════ CTA ═══════ -->
  <section class="py-24 lg:py-32 section-alt-8 section-divider">
    <div class="max-w-3xl mx-auto px-6 lg:px-12 text-center">
      <p class="text-[11px] font-mono uppercase tracking-[0.2em] text-blue mb-4">Contact</p>
      <h2 class="font-syne font-extrabold text-[clamp(2rem,6vw,4rem)] leading-[0.95] tracking-[-0.03em] text-white mb-6">
        Votre projet <span class="text-sky">ici</span> ?
      </h2>
      <p class="text-muted font-dm font-light text-sm sm:text-base max-w-lg mx-auto mb-10">
        On construit ensemble votre solution digitale sur mesure.
      </p>
      <a href={base + "contact"} class="btn-primary">Démarrer un projet →</a>
    </div>
  </section>

</Layout>
