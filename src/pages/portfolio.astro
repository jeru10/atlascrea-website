---
import Layout from '../layouts/Layout.astro';
import { portfolioWebsites } from '../data/siteData';
---

<Layout title="Réalisations — ATLAS CREA | Portfolio" description="Découvrez nos réalisations : sites web, branding et stratégies digitales pour nos clients à Marrakech et au Maroc.">

  <!-- Hero -->
  <section class="pt-32 pb-20 gradient-hero relative overflow-hidden">
    <div class="absolute top-1/4 right-1/3 w-80 h-80 rounded-full bg-brand-purple/15 blur-[100px]"></div>
    <div class="absolute bottom-0 left-1/4 w-72 h-72 rounded-full bg-brand-cyan/10 blur-[90px]"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <h1 class="text-4xl sm:text-6xl font-bold text-white mb-6">Nos <span class="gradient-text">Réalisations</span></h1>
      <p class="text-xl text-white/60 max-w-2xl mx-auto">Des projets concrets qui parlent d'eux-mêmes</p>
    </div>
  </section>

  <!-- Portfolio Grid -->
  <section class="py-20 bg-brand-navy">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 stagger-children">
        {portfolioWebsites.map(site => (
          <a href={site.url} target="_blank" rel="noopener noreferrer" class="group glass rounded-2xl overflow-hidden card-3d">
            <div class="aspect-video bg-brand-navy relative overflow-hidden">
              <img src={site.image} alt={site.name} class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-700" loading="lazy" />
              <div class="absolute inset-0 bg-brand-navy/20 group-hover:bg-brand-navy/50 transition-colors duration-300"></div>
              <div class="absolute inset-0 bg-gradient-to-t from-brand-navy/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-5">
                <span class="text-brand-cyan text-sm font-medium">Voir le site →</span>
              </div>
            </div>
            <div class="p-6">
              <h3 class="text-lg font-bold text-white group-hover:text-brand-cyan transition-colors mb-1">{site.name}</h3>
              <p class="text-white/40 text-sm mb-3">{site.desc}</p>
              <span class="text-xs text-white/30 block truncate">{site.url}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 relative">
    <div class="absolute inset-0 bg-gradient-to-b from-brand-navy via-brand-purple/5 to-brand-navy"></div>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 section-fade">
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-6">Vous aussi, <span class="gradient-text">lançons votre projet</span></h2>
      <p class="text-white/50 text-lg mb-8">Des résultats concrets pour votre entreprise</p>
      <a href="contact" class="btn-primary text-base !px-10 !py-4">Demander un devis</a>
    </div>
  </section>
</Layout>
