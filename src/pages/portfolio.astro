---
import Layout from '../layouts/Layout.astro';
const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');

const projects = [
  { name: "Munich Recruitment", url: "https://www.munichrecruitment.com", cat: "Recrutement", desc: "Plateforme de recrutement premium", image: "images/portfolio/munich-recruitment.jpg" },
  { name: "Abdol Luxury Tour", url: "https://abdoluxurytour.com", cat: "Tourisme de luxe", desc: "Expérience voyage haut de gamme", image: "images/portfolio/abdoluxurytour.jpg" },
  { name: "Mondrap", url: "https://mondrap.com", cat: "Mode & Vêtements", desc: "E-commerce de prêt-à-porter", image: "images/portfolio/mondrap.jpg" },
  { name: "Potentiel Consulting", url: "https://www.potentielconsulting.ma", cat: "Conseil", desc: "Site vitrine consulting", image: "images/portfolio/potentiel-consulting.jpg" },
  { name: "Atlas Epic Trek", url: "https://atlasepictrek.com", cat: "Aventure", desc: "Plateforme de trekking", image: "images/portfolio/atlasepictrek.jpg" },
  { name: "Charpente Maroc", url: "https://charpente-maroc.com", cat: "Construction", desc: "Site professionnel charpente", image: "images/portfolio/charpente-maroc.jpg" },
];
---

<Layout title="Réalisations — ATLAS CREA | Portfolio" description="Découvrez nos réalisations : sites web, branding et identités visuelles pour nos clients.">
  <div class="noise-overlay"></div>

  <!-- Hero -->
  <section class="pt-36 pb-20 bg-brand-navy relative overflow-hidden">
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-brand-purple/10 blur-[120px] rounded-full"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="section-label">NOS RÉALISATIONS</div>
      <h1 class="text-[clamp(2.5rem,8vw,5rem)] font-kanit font-bold leading-[0.95] text-white mb-6">
        Des créations qui <span class="gradient-text">marquent.</span>
      </h1>
      <p class="text-white/50 text-lg max-w-2xl">Chaque projet est une histoire unique. Découvrez nos dernières réalisations.</p>
    </div>
  </section>

  <!-- Portfolio Grid -->
  <section class="py-20 bg-brand-navy">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 stagger-children">
        {projects.map((project, i) => (
          <a href={project.url} target="_blank" rel="noopener noreferrer" class="work-card group block">
            <div class="aspect-[16/10] overflow-hidden relative">
              <img src={project.image} alt={project.name} class="w-full h-full object-cover object-top group-hover:scale-110 transition-transform duration-700" loading="lazy" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-500 scale-90 group-hover:scale-100">
                <div class="w-14 h-14 rounded-full bg-white text-black flex items-center justify-center shadow-2xl group-hover:rotate-12 transition-transform">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                </div>
              </div>
              <div class="absolute top-4 left-4">
                <span class="px-3 py-1 rounded-full bg-black/40 backdrop-blur-md border border-white/10 text-[10px] font-mono uppercase tracking-widest text-white">{project.cat}</span>
              </div>
            </div>
            <div class="p-5">
              <h3 class="text-base font-kanit font-bold text-white group-hover:text-brand-cyan transition-colors">{project.name}</h3>
              <p class="text-white/30 text-xs mt-1">{project.desc}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-brand-navy relative overflow-hidden border-t border-white/5">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center section-fade">
      <h2 class="text-3xl sm:text-4xl font-kanit font-bold text-white mb-4">
        Vous avez un projet <span class="gradient-text">en tête</span> ?
      </h2>
      <p class="text-white/40 text-lg mb-8">Parlons-en et créons quelque chose de grand ensemble.</p>
      <a href={base + "contact"} class="btn-primary">Démarrer un projet →</a>
    </div>
  </section>
</Layout>
