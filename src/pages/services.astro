---
import Layout from '../layouts/Layout.astro';
const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');

const servicesList = [
  { number: '01', title: 'Branding & Identité Visuelle', desc: 'Créez une marque mémorable qui se démarque.', details: "Nous créons des identités de marque qui racontent votre histoire. Du logo à la charte graphique, chaque élément est pensé pour vous différencier.", items: ['Logo & marque', 'Charte graphique complète', 'Guide de marque', 'Brand strategy'] },
  { number: '02', title: 'Social Media & Contenu', desc: 'Votre présence digitale, gérée avec stratégie.', details: "Développez votre audience sur les réseaux sociaux. Nous créons et gérons votre contenu pour engager votre communauté et développer votre visibilité.", items: ['Gestion Instagram/Facebook', 'Création de posts & reels', 'Stratégie de contenu', 'Community management'] },
  { number: '03', title: 'Sites Web & Landing Pages', desc: 'Des sites web qui convertissent.', details: "Nous concevons des sites web professionnels alliant design moderne et performance technique. Optimisés SEO, responsives, et conçus pour convertir.", items: ['Sites vitrines', 'E-commerce', 'Landing pages', 'WordPress / Sur mesure'] },
  { number: '04', title: 'Publicité & Ads', desc: 'Atteignez vos clients cibles.', details: "Des campagnes publicitaires performantes sur les plateformes clés. Nous gérons vos budgets pub et optimisons vos campagnes pour maximiser le ROI.", items: ['Meta Ads', 'Google Ads', 'Suivi & optimisation', 'Reporting mensuel'] },
  { number: '05', title: 'Vidéo & Motion', desc: "Captez l'attention en mouvement.", details: "Des contenus vidéo engageants pour vos réseaux sociaux et votre site web. De la conception au montage, nous produisons des visuels qui marquent.", items: ['Reels & stories', 'Spots publicitaires', 'Motion design', 'Montage vidéo'] },
  { number: '06', title: 'Design & Impression', desc: 'Votre marque visible partout.', details: "Des supports print de qualité professionnelle pour renforcer votre image. De la carte de visite à l'enseigne, nous imprimons votre marque.", items: ['Flyers & brochures', 'Cartes de visite', 'Panneaux & enseignes', 'Roll-ups & kakemonos'] },
];
---

<Layout title="Services — ATLAS CREA | Branding · Web · Social Media" description="Découvrez nos 6 services de communication digitale : Branding, Sites Web, Social Media, Publicité, Vidéo, Design et Impression à Marrakech.">
  <div class="noise-overlay"></div>

  <!-- Hero -->
  <section class="pt-36 pb-20 bg-brand-navy relative overflow-hidden">
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-brand-purple/10 blur-[120px] rounded-full"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="section-label">PRESTATIONS</div>
      <h1 class="text-[clamp(2.5rem,8vw,5rem)] font-kanit font-bold leading-[0.95] text-white mb-6">
        Des solutions qui <span class="gradient-text">comptent.</span>
      </h1>
      <p class="text-white/50 text-lg max-w-2xl">Nous accompagnons votre marque avec des services complets, de la stratégie à la création.</p>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="py-20 bg-surface-alt">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="space-y-3">
        {servicesList.map((svc, i) => (
          <div class="service-card section-fade" style={{ transitionDelay: `${i * 0.1}s` }}>
            <div class="flex flex-col md:flex-row gap-8 md:gap-12">
              <div class="flex-shrink-0 w-full md:w-64">
                <div class="flex items-center gap-4 mb-3">
                  <div class="w-10 h-10 rounded-full bg-gradient-to-br from-brand-purple/20 to-brand-cyan/20 flex items-center justify-center">
                    <span class="font-kanit font-bold gradient-text text-sm">{svc.number}</span>
                  </div>
                  <span class="text-xs font-mono text-white/20">/{svc.number}</span>
                </div>
                <h2 class="text-xl font-kanit font-bold text-white">{svc.title}</h2>
                <p class="text-brand-cyan text-sm mt-2">{svc.desc}</p>
              </div>
              <div class="flex-1">
                <p class="text-white/50 text-sm leading-relaxed mb-6">{svc.details}</p>
                <div class="grid grid-cols-2 gap-x-6 gap-y-3">
                  {svc.items.map((item) => (
                    <div class="flex items-center gap-2 text-sm text-white/60">
                      <span class="w-1.5 h-1.5 rounded-full bg-brand-cyan flex-shrink-0"></span>
                      {item}
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 bg-brand-navy relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-brand-purple/5 via-transparent to-brand-cyan/5"></div>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 section-fade">
      <h2 class="text-3xl sm:text-5xl font-kanit font-bold text-white leading-[0.95] mb-6">
        Besoin d'un service <span class="gradient-text">sur mesure</span> ?
      </h2>
      <p class="text-white/40 text-lg max-w-lg mx-auto mb-8">Contactez-nous pour discuter de votre projet. Réponse sous 24h.</p>
      <a href={base + "contact"} class="btn-primary">Démarrer un projet →</a>
    </div>
  </section>
</Layout>
