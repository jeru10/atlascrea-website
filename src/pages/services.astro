---
import Layout from '../layouts/Layout.astro';
const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');

const servicesList = [
  { number: '/01', title: 'Branding & Identité Visuelle', cat: 'Identité', desc: 'Stratégie de marque, logo, charte graphique, packaging', details: "Nous créons des identités de marque qui racontent votre histoire. Du logo à la charte graphique, chaque élément est pensé pour vous différencier.", items: ['Logo & marque', 'Charte graphique complète', 'Guide de marque', 'Brand strategy'] },
  { number: '/02', title: 'Sites Web & Landing Pages', cat: 'Digital', desc: 'Sites vitrines, e-commerce, landing pages optimisées', details: "Nous concevons des sites web professionnels alliant design moderne et performance technique. Optimisés SEO, responsives, et conçus pour convertir.", items: ['Sites vitrines', 'E-commerce', 'Landing pages', 'WordPress / Sur mesure'] },
  { number: '/03', title: 'Social Media & Contenu', cat: 'Social', desc: 'Gestion Instagram/Facebook, création de posts & reels', details: "Développez votre audience sur les réseaux sociaux. Nous créons et gérons votre contenu pour engager votre communauté et développer votre visibilité.", items: ['Gestion Instagram/Facebook', 'Création de posts & reels', 'Stratégie de contenu', 'Community management'] },
  { number: '/04', title: 'Publicité Digitale', cat: 'Ads', desc: 'Meta Ads, Google Ads, tracking & optimisation', details: "Des campagnes publicitaires performantes sur les plateformes clés. Nous gérons vos budgets pub et optimisons vos campagnes pour maximiser le ROI.", items: ['Meta Ads', 'Google Ads', 'Suivi & optimisation', 'Reporting mensuel'] },
  { number: '/05', title: 'Vidéo & Motion Design', cat: 'Motion', desc: 'Reels, spots publicitaires, motion design', details: "Des contenus vidéo engageants pour vos réseaux sociaux et votre site web. De la conception au montage, nous produisons des visuels qui marquent.", items: ['Reels & stories', 'Spots publicitaires', 'Motion design', 'Montage vidéo'] },
  { number: '/06', title: 'Design & Impression', cat: 'Print', desc: 'Flyers, brochures, panneaux, cartes de visite', details: "Des supports print de qualité professionnelle pour renforcer votre image. De la carte de visite à l'enseigne, nous imprimons votre marque.", items: ['Flyers & brochures', 'Cartes de visite', 'Panneaux & enseignes', 'Roll-ups & kakemonos'] },
];
---

<Layout title="Services — ATLAS CREA | Branding · Web · Social Media" description="Découvrez nos 6 services de communication digitale : Branding, Sites Web, Social Media, Publicité, Vidéo, Design et Impression à Marrakech.">

  <!-- ═══════ HERO ═══════ -->
  <section class="relative min-h-[70vh] flex items-center pt-32 pb-20 overflow-hidden bg-bg">
    <!-- Mesh gradient -->
    <div class="absolute inset-0 hero-mesh"></div>
    <div class="hero-grain"></div>
    <div class="hero-scanlines"></div>

    <div class="max-w-7xl mx-auto px-6 lg:px-12 relative z-10">
      <p class="text-[11px] font-mono uppercase tracking-[0.2em] text-muted mb-6">Prestations</p>
      <h1 class="font-syne font-extrabold text-[clamp(3rem,8vw,6rem)] leading-[0.9] tracking-[-0.03em] text-white max-w-4xl mb-6">
        <span class="word-reveal" data-delay="1.0"><span>Ce que</span></span>{' '}
        <span class="word-reveal" data-delay="1.06"><span>nous</span></span>{' '}
        <span class="word-reveal text-sky italic" data-delay="1.12"><span>faisons</span></span>
      </h1>
      <p class="hero-reveal text-muted text-sm sm:text-base font-dm font-light max-w-xl mb-10" data-delay="1.4">
        Branding · Sites Web · Social Media · SEO · Publicité · Print
      </p>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute right-8 bottom-8 hidden lg:flex flex-col items-center gap-3 z-10">
      <span class="text-[10px] font-mono tracking-[0.2em] text-muted vertical-rl" style="writing-mode: vertical-rl;">SCROLL</span>
      <div class="w-px h-16 bg-gradient-to-b from-muted to-transparent"></div>
    </div>
  </section>

  <!-- ═══════ MARQUEE ═══════ -->
  <div class="marquee py-3" style="background: #3654E3;">
    <div class="marquee-inner text-[11px] font-syne font-bold uppercase tracking-[0.2em]" style="color: #020E26;">
      <span>Branding</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>Sites Web</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>Social Media</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>SEO</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>Motion Design</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>Publicité</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>Print</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>Branding</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>Sites Web</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>Social Media</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>SEO</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>Motion Design</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>Publicité</span><span class="marquee-dot" style="background:#020E26;"></span>
      <span>Print</span><span class="marquee-dot" style="background:#020E26;"></span>
    </div>
  </div>

  <!-- ═══════ SERVICES LIST ═══════ -->
  <section class="py-24 lg:py-32 bg-bg section-divider">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="flex flex-col">
        {servicesList.map((svc, i) => (
          <div class="group service-row flex flex-col md:flex-row md:items-start gap-4 md:gap-12 py-10 border-b border-border cursor-pointer hover:border-blue/30 transition-colors"
               style="transition-delay: 0s;">
            <span class="text-[11px] font-mono text-muted font-light md:w-16 shrink-0 pt-1">{svc.number}</span>
            <div class="flex-1 grid md:grid-cols-3 gap-4 md:gap-8">
              <div>
                <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-blue mb-2 block">{svc.cat}</span>
                <h3 class="font-syne font-bold text-xl md:text-2xl text-white group-hover:text-sky transition-colors duration-300">{svc.title}</h3>
              </div>
              <p class="text-muted font-dm font-light text-sm leading-relaxed">{svc.desc}</p>
              <div class="flex flex-wrap gap-2">
                {svc.items.map((item) => (
                  <span class="text-[10px] font-mono uppercase tracking-[0.1em] px-3 py-1.5 border border-border text-muted">{item}</span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════ PROCESS ═══════ -->
  <section class="py-24 lg:py-32 section-alt-4 section-divider">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <p class="text-[11px] font-mono uppercase tracking-[0.2em] text-blue mb-4">Méthode</p>
      <h2 class="font-syne font-extrabold text-[clamp(2rem,6vw,4rem)] leading-[0.95] tracking-[-0.03em] text-white mb-16 max-w-2xl">
        Comment on <span class="text-sky">travaille</span>
      </h2>

      <div class="grid md:grid-cols-4 gap-8">
        {[
          { number: '01', title: 'Découverte', desc: 'On écoute votre business, vos objectifs et votre vision.' },
          { number: '02', title: 'Stratégie', desc: 'On construit un plan créatif adapté à votre marché.' },
          { number: '03', title: 'Création', desc: 'Notre équipe produit vos livrables avec attention aux détails.' },
          { number: '04', title: 'Lancement', desc: 'On déploie, on publie, on lance — et on reste disponibles.' },
        ].map((step, i) => (
          <div class="process-step">
            <span class="text-[40px] sm:text-[56px] font-syne font-extrabold text-blue/30 leading-none">0{i + 1}</span>
            <h3 class="font-syne font-bold text-lg text-white mt-2 mb-3">{step.title}</h3>
            <p class="text-muted font-dm font-light text-sm leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════ CTA ═══════ -->
  <section class="py-24 lg:py-32 section-alt-8 section-divider">
    <div class="max-w-3xl mx-auto px-6 lg:px-12 text-center">
      <p class="text-[11px] font-mono uppercase tracking-[0.2em] text-blue mb-4">Contact</p>
      <h2 class="font-syne font-extrabold text-[clamp(2rem,6vw,4rem)] leading-[0.95] tracking-[-0.03em] text-white mb-6">
        Envie de <span class="text-sky">travailler</span> ensemble ?
      </h2>
      <p class="text-muted font-dm font-light text-sm sm:text-base max-w-lg mx-auto mb-10">
        Racontes-nous ton projet et on construit la meilleure solution.
      </p>
      <a href={base + "contact"} class="btn-primary">Démarrer un projet →</a>
    </div>
  </section>

</Layout>
