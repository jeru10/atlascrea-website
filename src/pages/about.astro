---
import Layout from '../layouts/Layout.astro';
const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
---

<Layout title="À Propos — ATLAS CREA | Studio Créatif à Marrakech" description="Studio créatif basé à Marrakech, spécialisé dans le branding, les sites web, le social media et le design.">
  <div class="noise-overlay"></div>

  <!-- Hero -->
  <section class="pt-36 pb-20 bg-brand-navy relative overflow-hidden">
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-brand-purple/10 blur-[120px] rounded-full"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="section-label">QUI SOMMES-NOUS</div>
      <h1 class="text-[clamp(2.5rem,8vw,5rem)] font-kanit font-bold leading-[0.95] text-white mb-6">
        Studio créatif basé à <span class="gradient-text">Marrakech.</span>
      </h1>
      <p class="text-white/50 text-lg max-w-2xl">Nous accompagnons les entreprises dans leur transformation digitale avec des solutions créatives et sur-mesure.</p>
    </div>
  </section>

  <!-- Intro -->
  <section class="py-20 bg-brand-navy">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-16 items-start section-fade">
        <div>
          <div class="w-12 h-12 rounded-full bg-gradient-to-br from-brand-purple/20 to-brand-cyan/20 flex items-center justify-center mb-6">
            <span class="font-kanit font-bold gradient-text text-lg">AC</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-kanit font-bold text-white leading-tight mb-6">
            Une vision distincte à chaque projet, fusionnant <span class="gradient-text">stratégie + créativité</span> pour des marques audacieuses.
          </h2>
        </div>
        <div class="space-y-6">
          <p class="text-white/50 leading-relaxed">
            ATLAS CREA est un studio créatif basé à Marrakech, spécialisé dans la communication 360°. Nous accompagnons les marques dans leur transformation digitale avec des solutions créatives, stratégiques et sur-mesure.
          </p>
          <p class="text-white/50 leading-relaxed">
            Notre équipe combine expertise technique et sens artistique pour créer des identités digitales qui se démarquent. Du branding à la création de sites web, en passant par le social media et le design print, nous offrons une gamme complète de services.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="py-16 bg-brand-navy border-t border-b border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-10 section-fade">
        <div class="text-center">
          <p class="text-4xl sm:text-5xl font-kanit font-bold gradient-text">120<span class="text-white">+</span></p>
          <p class="text-white/40 text-sm font-mono uppercase tracking-widest mt-2">Projets livrés</p>
        </div>
        <div class="text-center">
          <p class="text-4xl sm:text-5xl font-kanit font-bold text-white">99<span class="text-white">%</span></p>
          <p class="text-white/40 text-sm font-mono uppercase tracking-widest mt-2">Satisfaction client</p>
        </div>
        <div class="text-center">
          <p class="text-4xl sm:text-5xl font-kanit font-bold text-white">3<span class="text-white">+</span></p>
          <p class="text-white/40 text-sm font-mono uppercase tracking-widest mt-2">Ans d'expérience</p>
        </div>
        <div class="text-center">
          <p class="text-4xl sm:text-5xl font-kanit font-bold text-white">4.9<span class="text-brand-cyan">★</span></p>
          <p class="text-white/40 text-sm font-mono uppercase tracking-widest mt-2">Avis clients</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 bg-brand-navy relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-brand-purple/5 via-transparent to-brand-cyan/5"></div>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 section-fade">
      <h2 class="text-3xl sm:text-5xl font-kanit font-bold text-white leading-[0.95] mb-6">
        Envie de travailler <span class="gradient-text">ensemble</span> ?
      </h2>
      <p class="text-white/40 text-lg max-w-lg mx-auto mb-8">Racontes-nous ton projet et on construit la meilleure solution.</p>
      <a href={base + "contact"} class="btn-primary">Contactez-nous →</a>
    </div>
  </section>
</Layout>
