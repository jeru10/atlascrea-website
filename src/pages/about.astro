---
import Layout from '../layouts/Layout.astro';
import { statsData, testimonials } from '../data/siteData';
---

<Layout title="À Propos — ATLAS CREA | Agence de Communication 360°" description="Découvrez ATLAS CREA, agence de communication 360° à Marrakech. Notre histoire, nos certifications et notre équipe dédiée.">

  <!-- Hero -->
  <section class="pt-32 pb-20 gradient-hero relative overflow-hidden">
    <div class="absolute top-1/3 right-1/4 w-96 h-96 rounded-full bg-brand-cyan/10 blur-[120px]"></div>
    <div class="absolute bottom-0 left-1/3 w-72 h-72 rounded-full bg-brand-purple/15 blur-[100px]"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="flex flex-col lg:flex-row gap-12 items-center">
        <div class="flex-1">
          <h1 class="text-4xl sm:text-6xl font-bold text-white mb-6">
            Qui sommes-<span class="gradient-text">nous</span> ?
          </h1>
          <p class="text-lg text-white/60 leading-relaxed max-w-xl">
            ATLAS CREA est une agence de communication 360° basée à Marrakech, née de la passion du digital 
            et de la volonté d'accompagner les entreprises marocaines dans leur transformation digitale.
          </p>
        </div>
        <div class="flex-1">
          <div class="glass rounded-3xl p-8 md:p-10 card-3d">
            <div class="text-6xl font-bold gradient-text mb-2">2019</div>
            <p class="text-white/50">Année de création</p>
            <div class="mt-6 grid grid-cols-2 gap-4">
              <div>
                <div class="text-2xl font-bold text-brand-cyan">50+</div>
                <div class="text-white/40 text-sm">Projets réalisés</div>
              </div>
              <div>
                <div class="text-2xl font-bold text-brand-cyan">100%</div>
                <div class="text-white/40 text-sm">Clients satisfaits</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Story -->
  <section class="py-20 bg-brand-navy">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto section-fade">
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-8 text-center">Notre <span class="gradient-text">Histoire</span></h2>
        <div class="space-y-6 text-white/60 text-lg leading-relaxed">
          <p>
            Fondée en 2019 à Marrakech, ATLAS CREA est née d'un constat simple : les entreprises marocaines 
            ont besoin d'un interlocuteur unique pour leur communication, capable de gérer aussi bien le digital 
            que le physique.
          </p>
          <p>
            Notre fondateur, <strong class="text-white">Yassine Kadalika</strong>, fort de son expérience dans le digital, 
            a réuni une équipe de talents passionnés pour offrir des solutions complètes et sur-mesure.
          </p>
          <p>
            Aujourd'hui, nous accompagnons des TPE, PME et startups dans toute leur stratégie de communication, 
            du branding à la publicité digitale, en passant par la création de sites web et le SEO.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Certifications -->
  <section class="py-16 relative">
    <div class="absolute inset-0 bg-gradient-to-b from-brand-navy via-brand-purple/5 to-brand-navy"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <h2 class="text-3xl font-bold text-white mb-10 text-center section-fade">Nos <span class="gradient-text">Certifications</span></h2>
      <div class="grid sm:grid-cols-3 gap-6 max-w-3xl mx-auto">
        <div class="glass rounded-2xl p-8 text-center card-3d section-fade">
          <div class="w-16 h-16 rounded-full mx-auto mb-4 flex items-center justify-center text-2xl font-bold" style="background-color: rgba(66,133,244,0.2); color: #4285F4">G</div>
          <h3 class="text-lg font-bold text-white mb-1">Google Partner</h3>
          <p class="text-white/50 text-sm">Certifié Google Ads</p>
        </div>
        <div class="glass rounded-2xl p-8 text-center card-3d section-fade">
          <div class="w-16 h-16 rounded-full mx-auto mb-4 flex items-center justify-center text-2xl font-bold" style="background-color: rgba(146,0,59,0.2); color: #92003B">E</div>
          <h3 class="text-lg font-bold text-white mb-1">Elementor Expert</h3>
          <p class="text-white/50 text-sm">Développement WordPress</p>
        </div>
        <div class="glass rounded-2xl p-8 text-center card-3d section-fade">
          <div class="w-16 h-16 rounded-full mx-auto mb-4 flex items-center justify-center text-2xl font-bold" style="background-color: rgba(24,119,242,0.2); color: #1877F2">M</div>
          <h3 class="text-lg font-bold text-white mb-1">Meta Certified</h3>
          <p class="text-white/50 text-sm">Publicité Meta</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="py-16 bg-brand-navy">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
        {statsData.map(stat => (
          <div class="text-center p-6 glass rounded-2xl section-fade">
            <div class="text-3xl sm:text-4xl font-bold gradient-text mb-2">
              {stat.prefix}<span class="counter-number" data-target={stat.value}>0</span>{stat.suffix}
            </div>
            <p class="text-white/50 text-sm">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Us -->
  <section class="py-20 relative">
    <div class="absolute inset-0 bg-gradient-to-b from-brand-navy via-brand-purple/5 to-brand-navy"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="section-fade text-center mb-14">
        <h2 class="text-3xl sm:text-4xl font-bold text-white">Pourquoi <span class="gradient-text">ATLAS CREA</span> ?</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="glass rounded-2xl p-8 text-center card-3d">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-brand-purple to-brand-cyan flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
          </div>
          <h3 class="text-white font-bold mb-2">Équipe Dédiée</h3>
          <p class="text-white/50 text-sm">Un chef de projet unique pour vous accompagner</p>
        </div>
        <div class="glass rounded-2xl p-8 text-center card-3d">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-brand-cyan to-brand-blue flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"/></svg>
          </div>
          <h3 class="text-white font-bold mb-2">Approche 360°</h3>
          <p class="text-white/50 text-sm">Tous vos besoins réunis chez un seul partenaire</p>
        </div>
        <div class="glass rounded-2xl p-8 text-center card-3d">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-brand-purple to-brand-blue flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 class="text-white font-bold mb-2">Réactivité</h3>
          <p class="text-white/50 text-sm">Des délais tenus et une disponibilité permanente</p>
        </div>
        <div class="glass rounded-2xl p-8 text-center card-3d">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-brand-cyan to-brand-purple flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          <h3 class="text-white font-bold mb-2">Résultats Garantis</h3>
          <p class="text-white/50 text-sm">Des KPIs clairs et une optimisation continue</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-brand-navy">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center section-fade">
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-6">Envie de travailler avec nous ?</h2>
      <p class="text-white/50 text-lg mb-8">Racontez-nous votre projet</p>
      <a href="/contact" class="btn-primary text-base !px-10 !py-4">Contactez-nous</a>
    </div>
  </section>
</Layout>
