---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppBtn from '../components/WhatsAppBtn.astro';
import SEO from '../components/SEO.astro';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}
const { title, description, ogImage } = Astro.props;
const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
---

<!DOCTYPE html>
<html lang="fr" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href={base}>
    <link rel="icon" type="image/png" href={base + "images/logo.png"} />
    <link rel="apple-touch-icon" href={base + "images/logo.png"} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <SEO title={title} description={description} ogImage={ogImage} />
    
    <!-- Lenis Smooth Scroll CDN (is:inline prevents bundling) -->
    <script is:inline src="https://unpkg.com/@studio-freight/lenis@1.0.42/dist/lenis.min.js"></script>
  </head>
  <body class="font-inter bg-brand-navy text-white antialiased">
    <!-- Preloader -->
    <div id="preloader" class="preloader">
      <div class="preloader-inner">
        <div class="preloader-brand">
          <div class="preloader-dot"></div>
          <span style="font-family:'Kanit',sans-serif;font-weight:700;color:white;font-size:18px;letter-spacing:-0.02em;">ATLAS CREA</span>
        </div>
        <div class="preloader-bar-track">
          <div id="preloader-bar" class="preloader-bar-fill"></div>
        </div>
        <div class="preloader-info">
          <span id="preloader-text" class="preloader-text">Initialisation...</span>
          <span id="preloader-percent" class="preloader-percent">0%</span>
        </div>
      </div>
    </div>

    <!-- Custom Cursor -->
    <div id="custom-cursor">
      <div class="cursor-dot" id="cursor-dot"></div>
      <div class="cursor-ring" id="cursor-ring"></div>
    </div>

    <Header />
    <main class="min-h-screen">
      <slot />
    </main>
    <Footer />
    <WhatsAppBtn />

    <script is:inline>
      // ═══════════ PRELOADER ═══════════
      (function() {
        const preloader = document.getElementById('preloader');
        const bar = document.getElementById('preloader-bar');
        const percent = document.getElementById('preloader-percent');
        const text = document.getElementById('preloader-text');
        const phrases = ['Initialisation...', 'Chargement...', 'Calibration...', 'Prêt pour le décollage...'];
        
        let count = 0;
        let phraseIdx = 0;
        const duration = 2000;
        const steps = 100;
        const intervalTime = duration / steps;

        // Text cycler
        setInterval(() => {
          phraseIdx = (phraseIdx + 1) % phrases.length;
          if (text) text.textContent = phrases[phraseIdx];
        }, 500);

        // Counter
        const timer = setInterval(() => {
          count++;
          if (bar) bar.style.width = count + '%';
          if (percent) percent.textContent = count + '%';
          if (count >= 100) {
            clearInterval(timer);
            // Exit preloader
            setTimeout(() => {
              preloader.classList.add('preloader-slide-up');
              setTimeout(() => {
                preloader.style.display = 'none';
                // Enable custom cursor after preloader
                document.body.classList.add('cursor-loaded');
              }, 800);
            }, 400);
          }
        }, intervalTime);
      })();

      // ═══════════ CUSTOM CURSOR ═══════════
      (function() {
        const isTouch = 'ontouchstart' in window || navigator.maxTouchPoints > 0;
        if (isTouch) return;

        const dot = document.getElementById('cursor-dot');
        const ring = document.getElementById('cursor-ring');
        let mouseX = -100, mouseY = -100;
        let ringX = -100, ringY = -100;

        document.addEventListener('mousemove', (e) => {
          mouseX = e.clientX;
          mouseY = e.clientY;
          if (dot) {
            dot.style.left = mouseX - 4 + 'px';
            dot.style.top = mouseY - 4 + 'px';
          }
        });

        // Smooth ring follower
        function updateRing() {
          ringX += (mouseX - ringX) * 0.15;
          ringY += (mouseY - ringY) * 0.15;
          if (ring) {
            ring.style.left = ringX - 20 + 'px';
            ring.style.top = ringY - 20 + 'px';
          }
          requestAnimationFrame(updateRing);
        }
        updateRing();

        // Hover effect on interactive elements
        document.addEventListener('mouseover', (e) => {
          const target = e.target.closest('a, button, [role="button"], input, textarea, select, [data-cursor="pointer"]');
          if (target) {
            document.body.classList.add('cursor-hover');
          }
          const viewTarget = e.target.closest('[data-cursor="view"]');
          if (viewTarget) {
            document.body.classList.remove('cursor-hover');
            document.body.classList.add('cursor-view');
          }
        });
        document.addEventListener('mouseout', (e) => {
          const target = e.target.closest('a, button, [role="button"], input, textarea, select, [data-cursor="pointer"]');
          if (target) {
            document.body.classList.remove('cursor-hover');
          }
          const viewTarget = e.target.closest('[data-cursor="view"]');
          if (viewTarget) {
            document.body.classList.remove('cursor-view');
          }
        });
      })();

      // ═══════════ LENIS SMOOTH SCROLL ═══════════
      (function() {
        var LenisClass = window.Lenis;
        if (typeof LenisClass !== 'undefined' && LenisClass) {
          try {
            // Enable Lenis mode: overflow hidden on html/body
            document.documentElement.classList.add('lenis');
            
            var lenis = new LenisClass({
              duration: 1.2,
              easing: function(t) { return Math.min(1, 1.001 - Math.pow(2, -10 * t)); },
              smoothWheel: true,
              wheelMultiplier: 1,
              touchMultiplier: 1.5,
            });
            
            // Store on window for debug
            window.__lenis = lenis;
            
            function raf(time) {
              lenis.raf(time);
              requestAnimationFrame(raf);
            }
            requestAnimationFrame(raf);
          } catch(e) {
            console.warn('Lenis init error:', e);
            document.documentElement.classList.remove('lenis');
          }
        } else {
          console.warn('Lenis not loaded');
        }
      })();

      // ═══════════ MAGNETIC BUTTONS ═══════════
      (function() {
        document.querySelectorAll('.magnetic-btn').forEach(btn => {
          btn.addEventListener('mousemove', (e) => {
            const rect = btn.getBoundingClientRect();
            const x = (e.clientX - rect.left - rect.width / 2) * 0.3;
            const y = (e.clientY - rect.top - rect.height / 2) * 0.3;
            btn.style.transform = `translate(${x}px, ${y}px)`;
          });
          btn.addEventListener('mouseleave', () => {
            btn.style.transform = 'translate(0, 0)';
          });
        });
      })();

      // ═══════════ HERO FLOATING ORB (Mouse follower) ═══════════
      (function() {
        const orb = document.getElementById('hero-orb');
        if (!orb) return;
        const hero = orb.closest('section');
        if (!hero) return;

        hero.addEventListener('mousemove', (e) => {
          const rect = hero.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          orb.style.transform = `translate(${x - 250}px, ${y - 250}px)`;
        });
      })();

      // ═══════════ HERO GEOMETRIC SHAPES (Mouse parallax) ═══════════
      (function() {
        const shapes = document.querySelectorAll('.hero-shape');
        if (!shapes.length) return;
        const hero = shapes[0].closest('section');
        if (!hero) return;

        hero.addEventListener('mousemove', (e) => {
          const rect = hero.getBoundingClientRect();
          const x = ((e.clientX - rect.left) / rect.width - 0.5) * 2;
          const y = ((e.clientY - rect.top) / rect.height - 0.5) * 2;
          
          shapes.forEach((shape, i) => {
            const speed = shape.dataset.speed || 1;
            shape.style.transform = `translate(${x * 20 * speed}px, ${y * 20 * speed}px)`;
          });
        });
      })();

      // ═══════════ INTERSECTION OBSERVER ═══════════
      document.addEventListener('DOMContentLoaded', () => {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        }, { threshold: 0.1 });
        
        document.querySelectorAll('.section-fade').forEach(el => observer.observe(el));
      
        // Stagger children
        document.querySelectorAll('.stagger-children').forEach(parent => {
          const children = parent.children;
          const staggerObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                Array.from(children).forEach((child, i) => {
                  child.style.transitionDelay = `${i * 0.1}s`;
                  child.classList.add('visible');
                });
                staggerObserver.unobserve(entry.target);
              }
            });
          }, { threshold: 0.1 });
          staggerObserver.observe(parent);
        });
        
        // Hero reveal
        document.querySelectorAll('.hero-reveal').forEach((el, i) => {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                setTimeout(() => {
                  el.classList.add('revealed');
                }, i * 150);
                observer.unobserve(entry.target);
              }
            });
          });
          observer.observe(el);
        });
      });
    </script>
  </body>
</html>