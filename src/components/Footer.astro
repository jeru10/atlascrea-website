---
const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
const footerNav = [
  { name: 'Services', href: base + 'services' },
  { name: 'À propos', href: base + 'about' },
  { name: 'Réalisations', href: base + 'portfolio' },
  { name: 'Pricing', href: base + 'pricing' },
  { name: 'Contact', href: base + 'contact' },
];
const footerServices = [
  { name: 'Branding & Identité', href: base + 'services' },
  { name: 'Social Media', href: base + 'services' },
  { name: 'Sites Web', href: base + 'services' },
  { name: 'Publicité & Ads', href: base + 'services' },
  { name: 'Vidéo & Motion', href: base + 'services' },
  { name: 'Design & Impression', href: base + 'services' },
];
---

<footer class="bg-brand-navy border-t border-white/10 relative z-50">
  <div class="grid grid-cols-1 lg:grid-cols-4 border-l border-white/10">
    <!-- Column 1: Brand & Time -->
    <div class="lg:col-span-1 border-r border-white/10 p-8 lg:p-12 flex flex-col justify-between min-h-[400px] lg:min-h-[500px]">
      <div>
        <a href={base} class="inline-block mb-8">
          <img src={base + "images/logo.png"} alt="ATLAS CREA" class="h-10 w-auto" />
        </a>
        <p class="text-white/40 text-sm leading-relaxed max-w-[200px]">
          Studio créatif à Marrakech qui accompagne les marques à grandir.
        </p>
      </div>
      <div class="space-y-2">
        <div class="flex items-center gap-2">
          <div class="w-2 h-2 bg-brand-cyan rounded-full animate-pulse"></div>
          <span class="font-mono text-[10px] uppercase tracking-widest text-white/40">Heure locale (Maroc)</span>
        </div>
        <p id="live-clock" class="font-kanit text-3xl font-bold tabular-nums text-white">--:--</p>
        <span class="font-mono text-xs text-white/30">Marrakech, Maroc (GMT+1)</span>
      </div>
    </div>

    <!-- Column 2: Navigation -->
    <div class="lg:col-span-1 border-r border-white/10">
      {footerNav.map((link) => (
        <a
          href={link.href}
          class="block px-8 lg:px-12 py-5 border-b border-white/10 text-white/60 hover:text-white hover:bg-white/[0.02] transition-all duration-300 group"
        >
          <span class="font-kanit text-lg font-medium tracking-tight">{link.name}</span>
          <span class="float-right text-white/20 group-hover:text-brand-cyan transition-colors">→</span>
        </a>
      ))}
    </div>

    <!-- Column 3: Contact + Social -->
    <div class="lg:col-span-1 border-r border-white/10 p-8 lg:p-12 space-y-10">
      <div>
        <h4 class="font-kanit font-bold text-white text-sm uppercase tracking-widest mb-6">Contact</h4>
        <ul class="space-y-4">
          <li>
            <span class="text-white/30 text-[10px] font-mono uppercase tracking-wider block mb-1">Email</span>
            <a href="mailto:contact@atlascrea.com" class="text-white/70 hover:text-brand-cyan text-sm transition-colors">contact@atlascrea.com</a>
          </li>
          <li>
            <span class="text-white/30 text-[10px] font-mono uppercase tracking-wider block mb-1">Téléphone</span>
            <a href="tel:+212605048514" class="text-white/70 hover:text-brand-cyan text-sm transition-colors">+212 6 05 04 85 14</a>
          </li>
          <li>
            <span class="text-white/30 text-[10px] font-mono uppercase tracking-wider block mb-1">Adresse</span>
            <p class="text-white/50 text-sm">Marrakech, Maroc</p>
          </li>
        </ul>
      </div>
      <div>
        <h4 class="font-kanit font-bold text-white text-sm uppercase tracking-widest mb-6">Suivez-nous</h4>
        <div class="flex gap-4">
          <a href="https://instagram.com/atlascrea" target="_blank" rel="noopener" class="w-10 h-10 rounded-full border border-white/10 flex items-center justify-center hover:border-brand-cyan hover:bg-brand-cyan/10 transition-all duration-300" aria-label="Instagram">
            <svg class="w-4 h-4 text-white/60 hover:text-brand-cyan transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 1.366.062 2.633.336 3.608 1.311.975.975 1.249 2.242 1.311 3.608.058 1.266.07 1.646.07 4.85s-.012 3.584-.07 4.85c-.062 1.366-.336 2.633-1.311 3.608-.975.975-2.242 1.249-3.608 1.311-1.266.058-1.646.07-4.85.07s-3.584-.012-4.85-.07c-1.366-.062-2.633-.336-3.608-1.311-.975-.975-1.249-2.242-1.311-3.608C2.175 15.584 2.163 15.204 2.163 12s.012-3.584.07-4.85c.062-1.366.336-2.633 1.311-3.608.975-.975 2.242-1.249 3.608-1.311C8.416 2.175 8.796 2.163 12 2.163zm0-2.163C8.755 0 8.333.015 7.052.072 5.78.128 4.968.33 4.204.627c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.052.015 8.333 0 8.755 0 12s.015 3.667.072 4.948c.059 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.988 8.755 24 12 24s3.667-.015 4.948-.072c1.277-.059 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.057-1.281.072-1.703.072-4.948s-.015-3.667-.072-4.948c-.059-1.277-.262-2.148-.558-2.913-.306-.788-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.015 15.245 0 12 0zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162S8.597 18.162 12 18.162s6.162-2.759 6.162-6.162S15.403 5.838 12 5.838zm0 10.162c-2.209 0-4-1.791-4-4s1.791-4 4-4 4 1.791 4 4-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
          <a href="https://facebook.com/atlascrea" target="_blank" rel="noopener" class="w-10 h-10 rounded-full border border-white/10 flex items-center justify-center hover:border-brand-cyan hover:bg-brand-cyan/10 transition-all duration-300" aria-label="Facebook">
            <svg class="w-4 h-4 text-white/60 hover:text-brand-cyan transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="https://linkedin.com/company/atlascrea" target="_blank" rel="noopener" class="w-10 h-10 rounded-full border border-white/10 flex items-center justify-center hover:border-brand-cyan hover:bg-brand-cyan/10 transition-all duration-300" aria-label="LinkedIn">
            <svg class="w-4 h-4 text-white/60 hover:text-brand-cyan transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Column 4: Big CTA -->
    <div class="lg:col-span-1 p-8 lg:p-12 flex flex-col justify-between min-h-[300px] lg:min-h-[500px]">
      <div>
        <p class="text-white/30 text-xs font-mono uppercase tracking-widest mb-4">Allons plus loin</p>
        <a href={base + "contact"} class="inline-block group">
          <h3 class="text-3xl lg:text-4xl font-kanit font-bold text-white group-hover:text-brand-cyan transition-colors leading-tight">
            Démarrer<br>
            un Projet<br>
            <span class="text-brand-cyan group-hover:translate-x-2 inline-block transition-transform">→</span>
          </h3>
        </a>
      </div>
      <div class="pt-8 border-t border-white/10 mt-auto">
        <p class="text-white/20 text-xs">
          © 2026 ATLAS CREA
        </p>
      </div>
    </div>
  </div>

  <!-- Live clock script -->
  <script>
    (function() {
      function updateClock() {
        const clock = document.getElementById('live-clock');
        if (!clock) return;
        const now = new Date();
        // Morocco is GMT+1 (no DST in 2026)
        const options = { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'Africa/Casablanca' };
        try {
          clock.textContent = new Intl.DateTimeFormat('fr-FR', options).format(now);
        } catch(e) {
          clock.textContent = now.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit', hour12: false });
        }
      }
      updateClock();
      setInterval(updateClock, 1000);
    })();
  </script>
</footer>