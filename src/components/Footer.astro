---
import { services } from '../data/siteData';
const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
---

<footer class="bg-brand-navy border-t border-white/5 pt-20 pb-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Top wave decoration -->
    <div class="text-center mb-16">
      <img src={base + "images/logo.png"} alt="ATLAS CREA" class="h-16 w-auto mx-auto mb-6" />
      <p class="text-3xl md:text-4xl font-bold gradient-text">ATLAS CREA</p>
      <p class="text-white/50 mt-2">Agence de Communication 360°</p>
    </div>

    <div class="grid md:grid-cols-4 gap-10 mb-12">
      <!-- Studio -->
      <div>
        <h4 class="text-white font-bold text-lg mb-4">Studio</h4>
        <p class="text-white/60 text-sm leading-relaxed">
          Agence de communication 360° basée à Marrakech. Nous accompagnons les entreprises dans leur transformation digitale avec des solutions créatives et sur-mesure.
        </p>
        <div class="flex gap-3 mt-6">
          <a href="https://facebook.com/atlascrea" target="_blank" rel="noopener" class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center hover:bg-brand-purple/30 transition-all duration-300" aria-label="Facebook">
            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="https://instagram.com/atlascrea" target="_blank" rel="noopener" class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center hover:bg-brand-purple/30 transition-all duration-300" aria-label="Instagram">
            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12s.015 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.988 8.74 24 12 24s3.667-.015 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.012 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227-.224.562-.479.96-.899 1.382-.419.419-.824.679-1.38.896-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421-.569-.224-.96-.479-1.379-.899-.421-.419-.69-.824-.9-1.38-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06l.045.03zm0 3.678c-3.405 0-6.162 2.76-6.162 6.162 0 3.405 2.76 6.162 6.162 6.162 3.405 0 6.162-2.76 6.162-6.162 0-3.405-2.76-6.162-6.162-6.162zM12 16c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm7.846-10.405c0 .795-.646 1.44-1.44 1.44-.795 0-1.44-.646-1.44-1.44 0-.794.646-1.439 1.44-1.439.793-.001 1.44.645 1.44 1.439z"/></svg>
          </a>
          <a href="https://linkedin.com/company/atlascrea" target="_blank" rel="noopener" class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center hover:bg-brand-purple/30 transition-all duration-300" aria-label="LinkedIn">
            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        </div>
      </div>

      <!-- Explorer -->
      <div>
        <h4 class="text-white font-bold text-lg mb-4">Explorer</h4>
        <ul class="space-y-3">
          <li><a href={base} class="text-white/50 hover:text-brand-cyan text-sm transition">Accueil</a></li>
          <li><a href={base + "services"} class="text-white/50 hover:text-brand-cyan text-sm transition">Services</a></li>
          <li><a href={base + "about"} class="text-white/50 hover:text-brand-cyan text-sm transition">À Propos</a></li>
          <li><a href={base + "portfolio"} class="text-white/50 hover:text-brand-cyan text-sm transition">Réalisations</a></li>
          <li><a href={base + "contact"} class="text-white/50 hover:text-brand-cyan text-sm transition">Contact</a></li>
          <li><a href={base + "pricing"} class="text-white/50 hover:text-brand-cyan text-sm transition">Pricing</a></li>
        </ul>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-white font-bold text-lg mb-4">Liens Rapides</h4>
        <ul class="space-y-3">
          <li><a href={base + "services#branding"} class="text-white/50 hover:text-brand-cyan text-sm transition">Branding & Identité</a></li>
          <li><a href={base + "services#web"} class="text-white/50 hover:text-brand-cyan text-sm transition">Création de Sites Web</a></li>
          <li><a href={base + "services#social"} class="text-white/50 hover:text-brand-cyan text-sm transition">Social Media</a></li>
          <li><a href={base + "services#seo"} class="text-white/50 hover:text-brand-cyan text-sm transition">SEO & Référencement</a></li>
          <li><a href={base + "contact"} class="text-white/50 hover:text-brand-cyan text-sm transition">Demander un devis</a></li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h4 class="text-white font-bold text-lg mb-4">Contact</h4>
        <ul class="space-y-4">
          <li>
            <span class="text-white/40 text-xs block mb-1">Email</span>
            <a href="mailto:contact@atlascrea.com" class="text-white/70 hover:text-brand-cyan text-sm transition">contact@atlascrea.com</a>
          </li>
          <li>
            <span class="text-white/40 text-xs block mb-1">Téléphone</span>
            <a href="tel:+212605048514" class="text-white/70 hover:text-brand-cyan text-sm transition">+212 6 05 04 85 14</a>
          </li>
          <li>
            <span class="text-white/40 text-xs block mb-1">Adresse</span>
            <p class="text-white/50 text-sm">Marrakech, Maroc</p>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom -->
    <div class="border-t border-white/5 pt-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-white/30 text-xs">
        © 2026 ATLAS CREA. Tous droits réservés.
      </p>
      <div class="flex gap-6">
        <a href="#" class="text-white/30 hover:text-white/50 text-xs transition">Mentions légales</a>
        <a href="#" class="text-white/30 hover:text-white/50 text-xs transition">Politique de confidentialité</a>
        <a href="#" class="text-white/30 hover:text-white/50 text-xs transition">CGV</a>
      </div>
    </div>
  </div>
</footer>
