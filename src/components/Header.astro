---
const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
const navLinks = [
  { name: 'Accueil', href: base, number: '01' },
  { name: 'Services', href: base + 'services', number: '02' },
  { name: 'À Propos', href: base + 'about', number: '03' },
  { name: 'Réalisations', href: base + 'portfolio', number: '04' },
  { name: 'Pricing', href: base + 'pricing', number: '05' },
];
---

<header id="header" class="fixed top-0 left-0 right-0 z-50 px-4 sm:px-6 lg:px-8">
  <div id="nav-container" class="mx-auto transition-all duration-700 max-w-full bg-transparent" data-scrolled-class="mt-4 max-w-5xl rounded-2xl !bg-brand-navy/80 backdrop-blur-2xl border border-white/10 shadow-2xl">
    <nav class="flex items-center justify-between py-6 md:py-6 px-0 md:px-6 transition-all duration-500" data-scrolled-class="py-3">
      <!-- Logo -->
      <a href={base} class="flex items-center gap-2 group">
        <img src={base + "images/logo.png"} alt="ATLAS CREA" class="h-10 w-auto" />
      </a>

      <!-- Desktop Menu -->
      <div class="hidden md:flex items-center gap-1">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="px-4 py-2 text-xs font-medium tracking-[0.15em] uppercase text-white/60 hover:text-white transition-colors duration-300 relative nav-link"
          >
            {link.name}
          </a>
        ))}
      </div>

      <!-- CTA + Hamburger -->
      <div class="flex items-center gap-4">
        <a href={base + "contact"} class="hidden md:inline-flex items-center gap-2 px-5 py-2.5 text-xs font-semibold tracking-wider uppercase bg-gradient-to-r from-brand-navy to-brand-blue text-white rounded-full hover:shadow-lg hover:shadow-brand-blue/30 transition-all duration-300">
          Contact →
        </a>
        <!-- Mobile Hamburger -->
        <button id="menu-toggle" class="md:hidden relative w-8 h-8 flex flex-col items-center justify-center gap-1.5 z-50" aria-label="Menu">
          <span class="block w-6 h-px bg-white transition-all duration-300"></span>
          <span class="block w-6 h-px bg-white transition-all duration-300"></span>
          <span class="block w-6 h-px bg-white transition-all duration-300"></span>
        </button>
      </div>
    </nav>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="fixed inset-0 z-40 bg-brand-navy/98 backdrop-blur-xl flex items-center justify-center opacity-0 pointer-events-none transition-all duration-500 md:hidden">
    <div class="flex flex-col items-center gap-8">
      {navLinks.map((link, i) => (
        <a
          href={link.href}
          class="text-3xl font-kanit font-bold text-white/80 hover:text-brand-cyan transition-colors duration-300 tracking-tight"
          style={{ transitionDelay: `${i * 0.1}s` }}
        >
          <span class="text-sm font-mono text-brand-cyan block text-center">{link.number}</span>
          {link.name}
        </a>
      ))}
      <a href={base + "contact"} class="mt-8 btn-primary text-base !px-10 !py-4">
        Démarrer un projet →
      </a>
    </div>
  </div>
</header>

<script>
  (function() {
    const header = document.getElementById('header');
    const navContainer = document.getElementById('nav-container');
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    let isMenuOpen = false;

    // Scroll effect
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const scrolled = window.scrollY > 50;
          const navContainer_ = document.getElementById('nav-container');
          if (navContainer_) {
            if (scrolled) {
              navContainer_.className = navContainer_.className
                .replace('max-w-full bg-transparent', 'max-w-5xl rounded-2xl bg-brand-navy/80 backdrop-blur-2xl border border-white/10 shadow-2xl');
            } else {
              navContainer_.className = navContainer_.className
                .replace('max-w-5xl rounded-2xl bg-brand-navy/80 backdrop-blur-2xl border border-white/10 shadow-2xl', 'max-w-full bg-transparent');
            }
          }
          // Add scrolled class to header for CSS
          header?.classList.toggle('scrolled', scrolled);
          
          // Adjust nav padding on scroll
          const navs = document.querySelectorAll('nav');
          navs.forEach(nav => {
            if (scrolled) {
              nav.classList.add('py-3');
              nav.classList.remove('py-6');
            } else {
              nav.classList.remove('py-3');
              nav.classList.add('py-6');
            }
          });
          
          ticking = false;
        });
        ticking = true;
      }
    });

    // Mobile menu toggle
    if (menuToggle && mobileMenu) {
      menuToggle.addEventListener('click', () => {
        isMenuOpen = !isMenuOpen;
        if (isMenuOpen) {
          mobileMenu.classList.remove('opacity-0', 'pointer-events-none');
          mobileMenu.classList.add('opacity-100', 'pointer-events-auto');
          document.body.style.overflow = 'hidden';
          // Animate hamburger to X
          const spans = menuToggle.querySelectorAll('span');
          if (spans.length >= 3) {
            spans[0].style.transform = 'translateY(7px) rotate(45deg)';
            spans[1].style.opacity = '0';
            spans[2].style.transform = 'translateY(-7px) rotate(-45deg)';
          }
        } else {
          mobileMenu.classList.add('opacity-0', 'pointer-events-none');
          mobileMenu.classList.remove('opacity-100', 'pointer-events-auto');
          document.body.style.overflow = '';
          const spans = menuToggle.querySelectorAll('span');
          if (spans.length >= 3) {
            spans[0].style.transform = '';
            spans[1].style.opacity = '';
            spans[2].style.transform = '';
          }
        }
      });

      // Close menu on link click
      mobileMenu.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          isMenuOpen = false;
          mobileMenu.classList.add('opacity-0', 'pointer-events-none');
          mobileMenu.classList.remove('opacity-100', 'pointer-events-auto');
          document.body.style.overflow = '';
          const spans = menuToggle.querySelectorAll('span');
          if (spans.length >= 3) {
            spans[0].style.transform = '';
            spans[1].style.opacity = '';
            spans[2].style.transform = '';
          }
        });
      });
    }
  })();
</script>
