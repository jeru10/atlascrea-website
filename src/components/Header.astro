---
import { services } from '../data/siteData';
// Ensure base ends with '/' so concatenation works
const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
---

<header id="header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href={base} class="flex items-center gap-3 group">
        <img src={base + "images/logo.png"} alt="ATLAS CREA" class="h-10 w-auto" />
      </a>

      <!-- Desktop Menu -->
      <div class="hidden md:flex items-center gap-8">
        <a href={base} class="text-white/80 hover:text-brand-cyan transition-colors duration-300 text-sm font-medium">Accueil</a>
        <a href={base + "services"} class="text-white/80 hover:text-brand-cyan transition-colors duration-300 text-sm font-medium">Services</a>
        <a href={base + "about"} class="text-white/80 hover:text-brand-cyan transition-colors duration-300 text-sm font-medium">À Propos</a>
        <a href={base + "portfolio"} class="text-white/80 hover:text-brand-cyan transition-colors duration-300 text-sm font-medium">Réalisations</a>
        <a href={base + "contact"} class="text-white/80 hover:text-brand-cyan transition-colors duration-300 text-sm font-medium">Contact</a>
        <a href={base + "pricing"} class="text-white/80 hover:text-brand-cyan transition-colors duration-300 text-sm font-medium">Pricing</a>
        <a href={base + "contact"} class="btn-primary text-sm !px-6 !py-2.5">Demander un devis</a>
      </div>

      <!-- Mobile hamburger -->
      <button id="menu-toggle" class="md:hidden flex flex-col gap-1.5 p-2 group" aria-label="Menu">
        <span class="block w-6 h-0.5 bg-white transition-all duration-300 group-[.open]:rotate-45 group-[.open]:translate-y-2"></span>
        <span class="block w-6 h-0.5 bg-white transition-all duration-300 group-[.open]:opacity-0"></span>
        <span class="block w-6 h-0.5 bg-white transition-all duration-300 group-[.open]:-rotate-45 group-[.open]:-translate-y-2"></span>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="md:hidden hidden glass-dark border-t border-white/10">
    <div class="px-4 py-6 space-y-4">
      <a href={base} class="block text-white/80 hover:text-brand-cyan py-2 text-lg font-medium transition">Accueil</a>
      <a href={base + "services"} class="block text-white/80 hover:text-brand-cyan py-2 text-lg font-medium transition">Services</a>
      <a href={base + "about"} class="block text-white/80 hover:text-brand-cyan py-2 text-lg font-medium transition">À Propos</a>
      <a href={base + "portfolio"} class="block text-white/80 hover:text-brand-cyan py-2 text-lg font-medium transition">Réalisations</a>
      <a href={base + "contact"} class="block text-white/80 hover:text-brand-cyan py-2 text-lg font-medium transition">Contact</a>
      <a href={base + "pricing"} class="block text-white/80 hover:text-brand-cyan py-2 text-lg font-medium transition">Pricing</a>
      <a href={base + "contact"} class="btn-primary inline-block text-center !px-8 !py-3 mt-4">Demander un devis</a>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('header');
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  // Scroll effect
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      header.classList.add('glass-dark');
      header.classList.remove('bg-transparent');
    } else {
      header.classList.remove('glass-dark');
    }
  });

  // Mobile menu toggle
  menuToggle.addEventListener('click', () => {
    menuToggle.classList.toggle('open');
    mobileMenu.classList.toggle('hidden');
  });

  // Close menu on link click
  mobileMenu.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menuToggle.classList.remove('open');
      mobileMenu.classList.add('hidden');
    });
  });
</script>
